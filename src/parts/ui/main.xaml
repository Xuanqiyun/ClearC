<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="腾挪 ClearC" Width="1220" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="#F5F5F7"
        Foreground="#1D1D1F" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- 设置里可以关掉的显示项：改这几个资源，界面上用到的地方都跟着变 -->
    <Visibility x:Key="MapCkVis">Visible</Visibility>
    <Visibility x:Key="MapBarVis">Visible</Visibility>
    <Visibility x:Key="MapPctVis">Visible</Visibility>
    <Visibility x:Key="MapMetaVis">Visible</Visibility>
    <Visibility x:Key="MapHealthVis">Visible</Visibility>
    <Visibility x:Key="AppMoveVis">Visible</Visibility>
    <Visibility x:Key="SubVis">Visible</Visibility>
    <!-- 配色：浅灰底 #F5F5F7、白色卡片、正文 #1D1D1F、次要文字 #6E6E73、分隔线 #E5E5EA、唯一的强调色是蓝 #0071E3，红色只给删除 -->
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== 文字 ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Visibility" Value="{DynamicResource SubVis}"/>
    </Style>
    <!-- 设置页：每一项的名字和说明 -->
    <Style x:Key="SetName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style x:Key="SetNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Caption}"/>
    <Style x:Key="HelpHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HelpPara" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#3A3A3C"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="24"/>
    </Style>
    <!-- 帮助页：条目是一行粗体标题，下面一两行说明（字号、行距、段距照苹果的帮助页：正文 14 / 行高 24，条目之间空 26） -->
    <Style x:Key="HelpLead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="HelpBody" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#424245"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="24"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="MaxWidth" Value="660"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="HelpGroup" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="HelpSum" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="HelpListHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="HelpIcon" TargetType="Border">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="#EAF2FD"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="HelpPill" TargetType="Border">
      <Setter Property="Background" Value="#F0F0F3"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="10,3,10,4"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
    <Style x:Key="HelpTile" TargetType="Border">
      <Setter Property="Background" Value="#F5F5F7"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,16,18,18"/>
    </Style>
    <Style x:Key="HelpSection" TargetType="Expander">
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="White" BorderBrush="#E5E5EA" BorderThickness="1" CornerRadius="12">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand" Content="{TemplateBinding Header}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="Hd" Background="Transparent" CornerRadius="11" Padding="16,13,20,13">
                        <DockPanel>
                          <TextBlock x:Name="Chev" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="12"
                                     Foreground="#86868B" VerticalAlignment="Center" Margin="14,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                          </TextBlock>
                          <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chev" Property="Foreground" Value="#0071E3"/></Trigger>
                        <MultiTrigger>
                          <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions>
                          <Setter TargetName="Hd" Property="Background" Value="#F7F7F9"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <StackPanel x:Name="Body" Visibility="Collapsed">
                  <Border Height="1" Background="#EDEDF0" Margin="16,0,16,0"/>
                  <ContentPresenter Margin="22,0,22,20"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 常见问题：一行一个问题，点开看答案 -->
    <Style x:Key="HelpQ" TargetType="Expander">
      <Setter Property="BorderBrush" Value="#EDEDF0"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <DockPanel>
                <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand" Content="{TemplateBinding Header}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="0,17,2,17">
                        <DockPanel>
                          <TextBlock x:Name="Chev" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11"
                                     Foreground="#86868B" VerticalAlignment="Center" Margin="16,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                          </TextBlock>
                          <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chev" Property="Foreground" Value="#0071E3"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,0,36,20"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 卡片 ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SegBox" TargetType="Border">
      <Setter Property="Background" Value="#EBEBF0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===== 按钮：圆角 8，悬停/按下时整体轻微变暗 ===== -->
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Background" Value="#E8E8ED"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
              <Border x:Name="Shade" Background="#000000" Opacity="0" CornerRadius="8"/>
              <Border x:Name="Ring" BorderBrush="#7FB5F0" BorderThickness="0" CornerRadius="8" Margin="-2"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.06"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shade" Property="Opacity" Value="0.14"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Secondary}"/>
    <!-- 列表自带的样式会把文字设成固定的深色，这里改回正文颜色（深色模式会跟着换） -->
    <Style TargetType="ListView"><Setter Property="Foreground" Value="#1D1D1F"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="#1D1D1F"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="#0071E3"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Background" Value="#D70015"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0066CC"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="2,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 列表表头：点列名按这一列排序，再点一下反过来 ===== -->
    <Style x:Key="ColHead" TargetType="Button">
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding" Value="0,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="ToolTip" Value="点一下按这一列排序，再点一下反过来"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#1D1D1F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 表头那一行：白底，下面一条细线 -->
    <Style x:Key="HeadBar" TargetType="Border">
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="0,4,0,4"/>
    </Style>
    <!-- ===== 页面里的二级选项卡：文字下面一条蓝线 ===== -->
    <Style x:Key="SubTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,22,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,6,2,7">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#1D1D1F"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#0071E3"/>
                <Setter Property="Foreground" Value="#1D1D1F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ===== 页面左侧的目录（省空间、常见问题修复）：一级标题下面一项一项，点哪项右边显示哪项 ===== -->
    <!-- 一级标题：黑色加粗，不缩进 -->
    <Style x:Key="TreeHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Margin" Value="10,16,0,6"/>
    </Style>
    <!-- 二级菜单：缩进，左边一条细的竖线把同一组连起来，看得出属于哪个一级标题 -->
    <Style x:Key="TreeItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#3A3A3C"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Rectangle Width="1" Fill="#D9D9DE" HorizontalAlignment="Left" Margin="15,0,0,0"/>
              <Border x:Name="Bd" CornerRadius="7" Padding="12,6,10,6" Margin="22,0,0,0" Background="Transparent">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8E8ED"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E3EEFF"/>
                <Setter Property="Foreground" Value="#0A5BC4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 能点的一级菜单（搬家管理的「可以搬的」「已经搬走的」）：黑色加粗，不缩进 -->
    <Style x:Key="TreeTop" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="7" Padding="10,7" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8E8ED"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E3EEFF"/>
                <Setter Property="Foreground" Value="#0A5BC4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 选项卡、目录上的数字和状态：小圆角标签，和名字分开 -->
    <Style x:Key="TabBadge" TargetType="Border">
      <Setter Property="Background" Value="#DEDEE4"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="6,0,6,1"/>
      <Setter Property="Margin" Value="7,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TabBadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
    </Style>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="7" Padding="10,7" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8E8ED"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E3EEFF"/>
                <Setter Property="Foreground" Value="#0A5BC4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 侧边栏导航 ===== -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Padding="11,8" Background="Transparent">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}"
                           FontSize="15" Foreground="#0071E3" VerticalAlignment="Center" Margin="0,0,11,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E1E1E6"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0071E3"/>
                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 侧边栏分组标题下面的项：比标题缩进一点 -->
    <Style x:Key="NavSub" TargetType="RadioButton" BasedOn="{StaticResource Nav}">
      <Setter Property="Margin" Value="10,0,0,3"/>
    </Style>
    <!-- ===== 分段控件（单选） ===== -->
    <!-- 外观选择：每种外观一张缩略图（浅色、深色、跟随系统），下面写名字；选中的那张描蓝边 -->
    <Style x:Key="ThemeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <ContentPresenter Margin="0" Cursor="Hand"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemePic" TargetType="Border">
      <Setter Property="Width" Value="120"/>
      <Setter Property="Height" Value="80"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="BorderBrush" Value="#C7C7CC"/></DataTrigger>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="BorderBrush" Value="#0071E3"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ThemeLbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#3A3A3C"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0066CC"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <!-- 和前一项之间的细竖线：第一项（Uid=first）、选中的、鼠标在上面的不画 -->
              <Rectangle x:Name="Sep" Width="1" Fill="#C9C9CF" HorizontalAlignment="Left" Margin="0,6"/>
              <Border x:Name="Bd" CornerRadius="6" Padding="12,4,12,5" Margin="1,0,0,0" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Uid" Value="first"><Setter TargetName="Sep" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="Uid" Value="nosep"><Setter TargetName="Sep" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Sep" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sep" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DEDEE4"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FEFEFE"/>
                <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.16"/></Setter.Value></Setter>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipRadio" TargetType="RadioButton" BasedOn="{StaticResource Seg}"/>
    <!-- 每一行的「删除 / 搬到其他盘 / 跳过」：一个横排的列表当分段控件用，选中项绑定到这一行的操作 -->
    <Style x:Key="SegList" TargetType="ListBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Background" Value="#EBEBF0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ItemsPanel">
        <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="2"><ItemsPresenter/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#3A3A3C"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" CornerRadius="6" Padding="11,4,11,5" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DEDEE4"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#FEFEFE"/>
                      <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.16"/></Setter.Value></Setter>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                      <Setter Property="Foreground" Value="#1D1D1F"/>
                    </Trigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Content" Value="删除"/></MultiTrigger.Conditions>
                      <Setter Property="Foreground" Value="#D70015"/>
                    </MultiTrigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Content" Value="搬到其他盘"/></MultiTrigger.Conditions>
                      <Setter Property="Foreground" Value="#0071E3"/>
                    </MultiTrigger>
                    <MultiTrigger>
                      <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Content" Value="执行"/></MultiTrigger.Conditions>
                      <Setter Property="Foreground" Value="#0071E3"/>
                    </MultiTrigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 文件类型胶囊（多选） ===== -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="13" Padding="12,4,12,5" Background="#F2F2F7">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5E5EA"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0071E3"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 勾选框：圆角小方块，勾上变蓝 ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="17" Height="17" CornerRadius="4.5" BorderThickness="1" BorderBrush="#B8B8BE" Background="White" VerticalAlignment="Center">
                <Grid>
                  <Path x:Name="Mark" Data="M 3.5 7.6 L 6.5 10.6 L 11.6 4.8" Stroke="White" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                  <Path x:Name="Dash" Data="M 4.5 7.5 L 10.5 7.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter x:Name="CP" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#0071E3"/>
                <Setter TargetName="Box" Property="Background" Value="#E8F1FC"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#0071E3"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#0071E3"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="#0071E3"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#0071E3"/>
                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="HasContent" Value="False"><Setter TargetName="CP" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 右键菜单 ===== -->
    <Style x:Key="Menu" TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="White" BorderBrush="#D2D2D7" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,8,8">
              <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18"/></Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuRow" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="12,6,28,6" MinWidth="180">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F1FC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuSep" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="#E5E5EA" Margin="8,4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 输入框 ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D2D2D7"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#AEAEB2"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0071E3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 运行记录用系统默认的多行文本框（有滚动条），只改颜色 -->
    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#3A3A3C"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== 下拉框 ===== -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0071E3"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#D2D2D7" BorderThickness="1" CornerRadius="7">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#6E6E73"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#AEAEB2"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0071E3"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="11,4,30,4" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="White" BorderBrush="#D2D2D7" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,12,14"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.16"/></Border.Effect>
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 细滚动条 ===== -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="#C7C7CC" CornerRadius="4" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#AEAEB2"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#8E8E93"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="MinWidth" Value="11"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="MinHeight" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                    <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== 进度条：圆角细条；不确定进度时轻轻闪烁 ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#0071E3"/>
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Pulse">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="0.25" To="0.85" Duration="0:0:0.8"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderBrush" Value="#D2D2D7"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <!-- ===== 查找条件的折叠面板：左边一个小箭头，展开时转向下 ===== -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" Focusable="False" Cursor="Hand" Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="2,6">
                      <DockPanel>
                        <TextBlock x:Name="Chev" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11"
                                   Foreground="#6E6E73" VerticalAlignment="Center" Margin="0,1,10,0" RenderTransformOrigin="0.5,0.5">
                          <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <ContentPresenter VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== 清理列表：每组一张圆角白卡片，行之间一条细线 ===== -->
    <Style x:Key="CardGroup" TargetType="GroupItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupItem">
            <StackPanel Margin="0,0,0,22">
              <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                <TextBlock Text="{Binding Items[0].GroupTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#1D1D1F"/>
                <Border Background="#E5E5EA" CornerRadius="8" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} 项'}" FontSize="11.5" Foreground="#3A3A3C"/>
                </Border>
                <TextBlock Text="{Binding Items[0].GroupNote}" FontSize="12" Foreground="#86868B" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
              </StackPanel>
              <Border Background="White" CornerRadius="12" BorderBrush="#E5E5EA" BorderThickness="1" Padding="0,2">
                <ItemsPresenter/>
              </Border>
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PlainRow" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Grid Background="Transparent">
              <Rectangle x:Name="Sep" Height="1" Fill="#E5E5EA" VerticalAlignment="Top" Margin="18,0,0,0"/>
              <ContentPresenter/>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- 显示出来的第一行不画分隔线：列表要设 AlternationCount（很大），排序、筛选以后按显示的顺序算 -->
              <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="CleanRow">
      <Grid Margin="18,12,14,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="CleanSize"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="CleanAct"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1D1D1F"/>
          <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="13.5" Foreground="#1D1D1F" VerticalAlignment="Center"
                   MinWidth="90" TextAlignment="Right" Margin="0,0,18,0"/>
        <ListBox Grid.Column="2" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action, Mode=TwoWay}" Style="{StaticResource SegList}" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

    <!-- ===== 重复文件结果表 ===== -->
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#86868B"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridViewColumnHeader">
            <Grid>
              <Border Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1" Padding="6,8,6,7">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"><Rectangle Width="1" Fill="#E5E5EA" HorizontalAlignment="Center" Margin="0,8"/></Border>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GridRow" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0,5"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F5F5F7"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F1FC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RootRow" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 查找位置：和文件类型一样的胶囊，勾上变蓝；自己加的文件夹带一个小叉可以移除 -->
    <Style x:Key="PillCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Bd" CornerRadius="13" Padding="12,4,12,5" Background="#F2F2F7">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E5E5EA"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0071E3"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillX" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Width="16" Height="16" CornerRadius="8" Background="Transparent">
              <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#26000000"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ===== 侧边栏分组标题 ===== -->
    <Style x:Key="NavHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="Margin" Value="4,14,0,5"/>
    </Style>
    <!-- ===== 开关（勾选框的另一种样子） ===== -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="40" Height="24" VerticalAlignment="Center">
                <Border x:Name="Track" CornerRadius="12" Background="#D1D1D6"/>
                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                  <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.25"/></Ellipse.Effect>
                </Ellipse>
              </Grid>
              <ContentPresenter x:Name="CP" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#34C759"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
              <Trigger Property="HasContent" Value="False"><Setter TargetName="CP" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ===== 可以选中的列表行（空间地图、软件、搬家记录） ===== -->
    <Style x:Key="SelRow" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="6,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F5F5F7"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F1FC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#3A3A3C"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
      <Setter Property="MaxWidth" Value="860"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- 系统健康里的一条记录（事件、拖慢开机的程序、驱动）：第一行加粗，详细说明在下面一行，右边是次数和时间，行与行之间一条细线 -->
    <DataTemplate x:Key="NoteRowTpl">
      <Border BorderBrush="#EFEFF4" BorderThickness="0,0,0,1" Padding="0,10,0,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Body}" Style="{StaticResource Caption}" Margin="18,1,0,0" VerticalAlignment="Top"/>
          <StackPanel>
            <TextBlock Text="{Binding Head}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"/>
            <TextBlock x:Name="Sub" Text="{Binding Sub}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0" ToolTip="{Binding Path}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Sub}" Value="{x:Null}"><Setter TargetName="Sub" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Sub}" Value=""><Setter TargetName="Sub" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- 空间地图的一行：图标、名字、占比条、大小、百分比 -->
    <DataTemplate x:Key="CandRowTpl">
      <Grid Margin="14,11,14,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="CandAct"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="Ck" Grid.Column="0" IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanMove}" VerticalAlignment="Top" Margin="0,2,0,0"/>
        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding PathText}" FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding PathText}"/>
          <TextBlock x:Name="Nt" Text="{Binding Note}" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Margin="0,3,0,0"/>
          <TextBlock x:Name="St" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button x:Name="CandOpen" Grid.Column="3" Content="打开" Tag="{Binding}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value=""><Setter TargetName="St" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Note}" Value=""><Setter TargetName="Nt" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding CanMove}" Value="False"><Setter TargetName="Ck" Property="Visibility" Value="Hidden"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="MapRowTpl">
      <Grid Margin="12,7,14,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MapCk"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MapBar"/>
          <ColumnDefinition Width="92"/>
          <ColumnDefinition Width="Auto" SharedSizeGroup="MapPct"/>
        </Grid.ColumnDefinitions>
        <!-- 项目复选框：和这一行是否选中绑在一起，点它只增减这一行，不影响其他已选的行 -->
        <CheckBox x:Name="Ck" Grid.Column="0" Visibility="{DynamicResource MapCkVis}" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand"
                  IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
        <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{Binding GlyphBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
          <DockPanel>
            <TextBlock x:Name="Lk" DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#86868B"
                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{Binding LockTip}"/>
            <Border x:Name="Mk" DockPanel.Dock="Right" Background="#FDEBEC" CornerRadius="6" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="已经在待删清单里">
              <TextBlock Text="待删" FontSize="11" Foreground="#C0101C"/>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
          </DockPanel>
          <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{DynamicResource MapMetaVis}" ToolTip="{Binding Meta}"/>
        </StackPanel>
        <Border Grid.Column="3" Height="8" Width="160" Margin="0,0,12,0" CornerRadius="4" Background="#EFEFF4" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{DynamicResource MapBarVis}">
          <Border Width="{Binding Bar}" HorizontalAlignment="Left" CornerRadius="4" Background="#0071E3"/>
        </Border>
        <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="5" Width="58" Text="{Binding Pct}" Foreground="#86868B" TextAlignment="Right" VerticalAlignment="Center" Visibility="{DynamicResource MapPctVis}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Locked}" Value="True"><Setter TargetName="Lk" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Marked}" Value="True"><Setter TargetName="Mk" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="type"><Setter TargetName="Ck" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="recent"><Setter TargetName="Ck" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==================== 侧边栏 ==================== -->
    <Border Grid.Column="0" Grid.RowSpan="3" Background="#ECECF0" BorderBrush="#DCDCE1" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
          <Border Width="36" Height="36" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3A9BFF" Offset="0"/>
                <GradientStop Color="#0062D6" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="腾挪 ClearC" FontSize="15" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal"/>
            <TextBlock x:Name="AppVer" Text="" FontSize="11.5" Foreground="#86868B" Margin="0,1,0,0"/>
            <TextBlock x:Name="ModeTag" Text="" FontSize="11" Foreground="#0066CC" Margin="0,1,0,0" Cursor="Hand" ToolTip="点一下到设置里换模式"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="BtnTheme" Style="{StaticResource LinkButton}" Foreground="#6E6E73" Padding="11,6" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="BtnThemeText" Text="外观：浅色" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnLang" Style="{StaticResource LinkButton}" Foreground="#6E6E73" Padding="11,6" HorizontalAlignment="Left" ToolTip="中文 / English">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="BtnLangText" Text="English" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnFeedback" Style="{StaticResource LinkButton}" Foreground="#6E6E73" Padding="11,6" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock Text="使用反馈" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnLog" Style="{StaticResource LinkButton}" Foreground="#6E6E73" Padding="11,6" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="BtnLogText" Text="运行记录" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- 窗口矮的时候（比如笔记本 150% 缩放）放不下全部页面：这一栏可以上下滚动，「设置」不会被挤掉 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
          <TextBlock Text="清理" Style="{StaticResource NavHead}" Margin="4,0,0,5"/>
          <RadioButton x:Name="NavClean" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xEDA2;" Content="清理 C 盘" IsChecked="True"/>
          <RadioButton x:Name="NavDup" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE8C8;" Content="重复文件"/>
          <RadioButton x:Name="NavSave" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE7B8;" Content="省空间"/>
          <TextBlock Text="分析" Style="{StaticResource NavHead}"/>
          <RadioButton x:Name="NavMap" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE9D9;" Content="空间地图"/>
          <RadioButton x:Name="NavApps" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE71D;" Content="软件管理"/>
          <RadioButton x:Name="NavHealth" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE95E;" Content="系统健康"/>
          <TextBlock x:Name="NavHeadManage" Text="管理" Style="{StaticResource NavHead}"/>
          <RadioButton x:Name="NavMoves" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE8AB;" Content="搬家管理"/>
          <RadioButton x:Name="NavAuto" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE823;" Content="自动提醒"/>
          <RadioButton x:Name="NavLog" GroupName="nav" Style="{StaticResource NavSub}" Tag="&#xE81C;" Content="操作日志"/>
          <RadioButton x:Name="NavHelp" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE897;" Content="帮助" Margin="0,12,0,3"/>
          <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource Nav}" Tag="&#xE713;" Content="设置"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ==================== 清理 C 盘 ==================== -->
    <Grid x:Name="PageClean" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,18">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <Button x:Name="BtnCleanCustom" Style="{StaticResource LinkButton}" Content="自定义清理项…" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="自己加要清理的文件夹，或者排除不想碰的文件夹（在「设置」里）"/>
          <Button x:Name="BtnHogs" Content="分析占用" Margin="0,0,8,0" ToolTip="打开「空间地图」扫描 C 盘，看清哪些文件夹和文件最占地方"/>
          <Button x:Name="BtnScan" Content="扫描"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="清理 C 盘" Style="{StaticResource PageTitle}"/>
          <TextBlock x:Name="Hint" Style="{StaticResource PageSub}"
                     Text="一键清理缓存和临时文件，或者先扫描，再逐项选择。"/>
        </StackPanel>
      </DockPanel>

      <!-- 容量卡片、搬家目标和清理列表放在同一个滚动区里，整页一起滚；分类选项卡和表头滚到顶上就停住 -->
      <Grid x:Name="CleanHost" Grid.Row="1" Grid.IsSharedSizeScope="True" ClipToBounds="True">
      <ScrollViewer x:Name="CleanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
      <StackPanel>
      <!-- 存储空间：已用 / 可释放 / 可用 -->
      <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
        <DockPanel>
          <Button x:Name="BtnOneClick" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="一键清理" FontSize="14" Padding="24,9"
                  VerticalAlignment="Center" Margin="28,0,0,0"
                  ToolTip="自动扫描，清掉所有安全项和默认选中的项目，并把微信、QQ、飞书、钉钉等聊天记录搬到空间最大的其他盘。不会关闭休眠、不清空回收站，个人文件夹（桌面、文档、下载等）里的东西一律不删。"/>
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="CapTotal" DockPanel.Dock="Right" Foreground="#86868B" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CapFree" Text="—" FontSize="24" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal"/>
                <TextBlock Text="可用" FontSize="14" Foreground="#6E6E73" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
              </StackPanel>
            </DockPanel>
            <Border Height="10" CornerRadius="5" Background="#E5E5EA" Margin="0,11,0,10">
              <Grid x:Name="CapBar">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*"/>
                  <ColumnDefinition Width="0*"/>
                  <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#8E8E93" CornerRadius="5,0,0,5"/>
                <Border Grid.Column="1" Background="#0071E3"/>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#8E8E93" VerticalAlignment="Center"/>
              <TextBlock Text="已用" Style="{StaticResource Caption}" Margin="6,0,18,0"/>
              <Ellipse Width="8" Height="8" Fill="#0071E3" VerticalAlignment="Center"/>
              <TextBlock x:Name="CapReclaim" Text="可释放（扫描后显示）" Style="{StaticResource Caption}" Margin="6,0,18,0"/>
              <Ellipse Width="8" Height="8" Fill="#D1D1D6" VerticalAlignment="Center"/>
              <TextBlock Text="可用" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- 搬家目标 -->
      <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,20">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#0071E3" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="搬家目标" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ComboBox x:Name="DestPick" Width="380" VerticalAlignment="Center"/>
            <Button x:Name="BtnDestBrowse" Style="{StaticResource LinkButton}" Content="选择文件夹…" Margin="14,0,0,0" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="DestHint" Style="{StaticResource Caption}" Margin="26,7,0,0" TextWrapping="Wrap"
                     Text="聊天记录等搬到这里，C 盘原位置留一个链接，软件照常使用。"/>
        </StackPanel>
      </Border>

      <!-- 扫描结果总览：一共几类、每类几项，一眼看出下面还有很多 -->
      <Border x:Name="CleanOverview" Background="#EAF3FF" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
        <DockPanel>
          <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#0071E3" VerticalAlignment="Top" Margin="0,1,10,0"/>
          <TextBlock x:Name="CleanOverviewText" TextWrapping="Wrap" Foreground="#1D1D1F" LineHeight="20"/>
        </DockPanel>
      </Border>
      <!-- 分类选项卡和表头占的位置：真正的那一排浮在列表上面（CleanBar），滚过头以后停在顶上 -->
      <Border x:Name="CleanBarSlot" Visibility="Collapsed"/>
      <!-- 列表自己不滚动（没有内部滚动条），只显示选中的那一类，跟着整页滚 -->
      <Border x:Name="CleanListCard" Background="White" CornerRadius="0,0,12,12" BorderBrush="#E5E5EA" BorderThickness="1,0,1,1" Padding="0,0,0,2" Margin="0,0,0,8" Visibility="Collapsed">
      <StackPanel>
      <ListView x:Name="List" Background="Transparent" BorderThickness="0" Padding="0" AlternationCount="1000000"
                ItemTemplate="{StaticResource CleanRow}" ItemContainerStyle="{StaticResource PlainRow}">
        <ListView.ContextMenu>
          <ContextMenu x:Name="CleanMenu" Style="{StaticResource Menu}">
            <MenuItem x:Name="CmOpen" Header="打开所在文件夹" Style="{StaticResource MenuRow}"/>
            <MenuItem x:Name="CmOpenAll" Header="打开全部位置" Style="{StaticResource MenuRow}"/>
            <MenuItem x:Name="CmCopy" Header="复制路径" Style="{StaticResource MenuRow}"/>
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.Template>
          <ControlTemplate TargetType="ListView"><ItemsPresenter/></ControlTemplate>
        </ListView.Template>
      </ListView>
      <TextBlock x:Name="CleanFilterEmpty" Text="这一类里没有这种操作的项目，换一个操作看看" Foreground="#86868B" Margin="18,16,18,16" Visibility="Collapsed"/>
      </StackPanel>
      </Border>
      <StackPanel x:Name="EmptyClean" HorizontalAlignment="Center" Margin="0,40,0,40" IsHitTestVisible="False">
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
        <TextBlock x:Name="EmptyCleanText" Text="点「扫描」看看 C 盘里有什么可以清理" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
      </StackPanel>
      </ScrollViewer>
      <!-- 分类选项卡和表头：平时就在列表上面；往下滚到它碰到顶边以后就停在那里，下面的列表照常滚 -->
      <Border x:Name="CleanBar" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#F5F5F7" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock x:Name="CleanTabInfo" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <Border Style="{StaticResource SegBox}" VerticalAlignment="Center">
              <WrapPanel x:Name="CleanTabs"/>
            </Border>
          </DockPanel>
          <TextBlock x:Name="CleanTabNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="4,0,4,8"/>
          <Border Background="White" CornerRadius="12,12,0,0" BorderBrush="#E5E5EA" BorderThickness="1,1,1,0">
            <Border Style="{StaticResource HeadBar}">
              <Grid x:Name="CleanHead" Margin="18,0,14,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CleanSize"/>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="CleanAct"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Tag="name" Content="名称" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Tag="size" Content="大小" Style="{StaticResource ColHead}" HorizontalAlignment="Right" Margin="0,0,18,0"/>
                <ComboBox Grid.Column="2" x:Name="CleanOpFilter" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip="只看某一种操作的项目，比如只看要删除的、只看跳过的。排序不变"/>
              </Grid>
            </Border>
          </Border>
        </StackPanel>
      </Border>
      <!-- 下面还有内容时浮在底部的提示，点一下往下翻一屏 -->
      <Button x:Name="CleanMore" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed" Cursor="Hand" ToolTip="往下翻一屏">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border Background="#1D1D1F" CornerRadius="16" Padding="16,7">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25"/></Border.Effect>
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Button.Template>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="CleanMoreText" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
          <TextBlock Text="&#xE74B;" FontFamily="{StaticResource Icons}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0"/>
        </StackPanel>
      </Button>
      </Grid>

      <DockPanel Grid.Row="2" Margin="0,14,0,0">
        <Button x:Name="BtnRun" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="执行所选操作" Padding="22,8" IsEnabled="False"/>
        <TextBlock x:Name="Summary" Text="" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,16,0"/>
      </DockPanel>
    </Grid>

    <!-- ==================== 重复文件 ==================== -->
    <Grid x:Name="PageDup" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <Button x:Name="BtnDupStop" Content="停止" Margin="0,0,8,0" IsEnabled="False"/>
          <Button x:Name="BtnDupScan" Content="开始查找" Style="{StaticResource Primary}" Padding="20,6"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="重复文件" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="找出内容完全相同的文件，每组留一份。"/>
        </StackPanel>
      </DockPanel>

      <!-- 查找条件：一类一个选项卡（选项卡上写着现在选的是什么）；点「开始查找」后收起来，只留这一排，结果占满下面 -->
      <Border Grid.Row="1" x:Name="DupFilterCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel Margin="16,4,14,0">
            <Button x:Name="DupFilterToggle" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="收起" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="FilterSummary" DockPanel.Dock="Right" Visibility="Collapsed"/>
            <WrapPanel>
              <RadioButton x:Name="DTabRoots" GroupName="dtab" Style="{StaticResource SubTab}" IsChecked="True">
                <StackPanel Orientation="Horizontal"><TextBlock Text="查找位置"/><Border Style="{StaticResource TabBadge}" Background="#EFEFF4" Margin="8,0,0,0"><TextBlock x:Name="DTabRootsVal" Style="{StaticResource TabBadgeText}" MaxWidth="230" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="DTabType" GroupName="dtab" Style="{StaticResource SubTab}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="文件类型"/><Border Style="{StaticResource TabBadge}" Background="#EFEFF4" Margin="8,0,0,0"><TextBlock x:Name="DTabTypeVal" Style="{StaticResource TabBadgeText}" MaxWidth="230" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="DTabSize" GroupName="dtab" Style="{StaticResource SubTab}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="文件大小"/><Border Style="{StaticResource TabBadge}" Background="#EFEFF4" Margin="8,0,0,0"><TextBlock x:Name="DTabSizeVal" Style="{StaticResource TabBadgeText}" MaxWidth="230" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="DTabMode" GroupName="dtab" Style="{StaticResource SubTab}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="怎样算重复"/><Border Style="{StaticResource TabBadge}" Background="#EFEFF4" Margin="8,0,0,0"><TextBlock x:Name="DTabModeVal" Style="{StaticResource TabBadgeText}" MaxWidth="230" TextTrimming="CharacterEllipsis"/></Border></StackPanel>
              </RadioButton>
            </WrapPanel>
          </DockPanel>
          <Border x:Name="DupFilterBody" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Padding="20,12,20,12">
            <Grid>
              <StackPanel x:Name="DPaneRoots">
              <ListBox x:Name="Roots" BorderThickness="0" Background="Transparent" Padding="0" ItemContainerStyle="{StaticResource RootRow}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource PillCheck}" ToolTip="{Binding Detail}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <Button x:Name="X" Tag="{Binding}" Style="{StaticResource PillX}" Visibility="Collapsed" Margin="6,0,-5,0" ToolTip="不在这里找了，移除"/>
                      </StackPanel>
                    </CheckBox>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Removable}" Value="True"><Setter TargetName="X" Property="Visibility" Value="Visible"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                <Button x:Name="BtnAddRoot" Style="{StaticResource LinkButton}" Content="添加文件夹…" Margin="0,0,14,0"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="系统目录、Program Files、AppData 和开发环境（.git、node_modules、conda）会自动跳过。"/>
              </StackPanel>
              </StackPanel>
              <StackPanel x:Name="DPaneType" Visibility="Collapsed">
              <WrapPanel x:Name="TypeChips"/>
              <DockPanel Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock DockPanel.Dock="Left" Text="其他扩展名" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                <Button x:Name="TypeReset" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="全部重置" Margin="12,0,0,0"/>
                <TextBox x:Name="ExtraExt" MinWidth="240" ToolTip="上面没有的类型，用空格隔开，例如 .dwg .step .sldprt"/>
              </DockPanel>
              </StackPanel>
              <StackPanel x:Name="DPaneSize" Visibility="Collapsed">
              <Border Style="{StaticResource SegBox}"><StackPanel x:Name="SizeChips" Orientation="Horizontal"/></Border>
              <StackPanel x:Name="SizeCustomRow" Orientation="Horizontal" Margin="0,9,0,0" Visibility="Collapsed">
                <TextBlock Text="从" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                <TextBox x:Name="SizeMin" Width="76"/>
                <ComboBox x:Name="SizeMinUnit" Width="66" Margin="6,0,0,0" SelectedIndex="1">
                  <ComboBoxItem Content="KB"/><ComboBoxItem Content="MB"/><ComboBoxItem Content="GB"/>
                </ComboBox>
                <TextBlock Text="到" Style="{StaticResource Caption}" Margin="16,0,8,0"/>
                <TextBox x:Name="SizeMax" Width="76"/>
                <ComboBox x:Name="SizeMaxUnit" Width="66" Margin="6,0,0,0" SelectedIndex="1">
                  <ComboBoxItem Content="KB"/><ComboBoxItem Content="MB"/><ComboBoxItem Content="GB"/>
                </ComboBox>
                <TextBlock x:Name="SizeHint" Text="留空表示不限" Style="{StaticResource Caption}" Margin="14,0,0,0"/>
              </StackPanel>
              </StackPanel>
              <StackPanel x:Name="DPaneMode" Visibility="Collapsed">
              <WrapPanel>
                <Border Style="{StaticResource SegBox}" Margin="0,0,28,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ModeName" GroupName="dupmode" Content="名字和内容都相同" IsChecked="True" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ModeContent" GroupName="dupmode" Content="只看内容，名字不同也算" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="ModeSimilar" GroupName="dupmode" Content="相似照片" Style="{StaticResource Seg}"
                                 ToolTip="找看起来一样的照片：不同分辨率、重新压缩过、轻微裁剪过的也算。只看 jpg、png、bmp、gif、tif、webp、heic。不是同一个文件，删之前自己看一眼"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="SimilarRow" Orientation="Horizontal" Margin="0,0,28,0" Visibility="Collapsed">
                  <TextBlock Text="相似程度" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border Style="{StaticResource SegBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="SimStrict" GroupName="simlvl" Content="几乎一样" Style="{StaticResource Seg}" ToolTip="64 位指纹相差 4 位以内：同一张照片的不同尺寸、不同压缩"/>
                      <RadioButton x:Name="SimNormal" GroupName="simlvl" Content="相似" IsChecked="True" Style="{StaticResource Seg}" ToolTip="相差 8 位以内：加上轻微裁剪、调色"/>
                      <RadioButton x:Name="SimLoose" GroupName="simlvl" Content="大致相似" Style="{StaticResource Seg}" ToolTip="相差 12 位以内：连拍、构图相近的也会归到一起，误判会多"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="比对方式" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <Border Style="{StaticResource SegBox}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="SpeedFast" GroupName="dupspeed" Content="快速" IsChecked="True" Style="{StaticResource Seg}"
                                   ToolTip="16 MB 以内的文件读全文；更大的读头尾和 16 处抽样（每个约 1 MB）。删除前再逐字节完整比对。"/>
                      <RadioButton x:Name="SpeedExact" GroupName="dupspeed" Content="完整比对" Style="{StaticResource Seg}"
                                   ToolTip="每个可疑文件都读完全部内容。大视频多的时候会慢很多。"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </WrapPanel>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0"
                         Text="快速模式下大文件只抽样读约 1 MB；删除前都会逐字节完整核对，有任何不同就不删。"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- 结果 -->
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0,0,0,6">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="18,12,14,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="每组只留一份：" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
              <Button x:Name="BtnKeepNew"  Style="{StaticResource Small}" Content="留最新的" Margin="0,0,6,0" IsEnabled="False"/>
              <Button x:Name="BtnKeepOld"  Style="{StaticResource Small}" Content="留最早的" Margin="0,0,6,0" IsEnabled="False"/>
              <Button x:Name="BtnPickC"    Style="{StaticResource Small}" Content="优先留 C 盘以外的" Margin="0,0,6,0" IsEnabled="False"/>
              <Button x:Name="BtnKeepIn"   Style="{StaticResource Small}" Content="留某个文件夹里的…" Margin="0,0,6,0" IsEnabled="False" ToolTip="选一个文件夹：每组优先保留在这个文件夹（含子文件夹）里的那份，其余勾上；这一组里没有的就留最新的"/>
              <Button x:Name="BtnKeepShort" Style="{StaticResource Small}" Content="留路径最短的" Margin="0,0,6,0" IsEnabled="False" ToolTip="每组保留路径最短（层级最浅）的那份"/>
              <Button x:Name="BtnPickNone" Style="{StaticResource Small}" Content="全部取消" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="DupProgressText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#6E6E73"
                       Text="只有内容逐字节完全相同才算重复。"/>
          </DockPanel>
          <Grid>
            <ListView x:Name="DupList" Background="White" BorderThickness="0" ItemContainerStyle="{StaticResource GridRow}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
              <ListView.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#EFEFF4" BorderThickness="0,1,0,0" Padding="16,14,12,6" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding Items[0].TypeBrush}"/>
                          <TextBlock Text="{Binding Items[0].GroupName}" FontWeight="SemiBold" Foreground="#1D1D1F" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Items[0].GroupMeta}" Foreground="#86868B" Margin="12,0,0,0" VerticalAlignment="Center"/>
                          <Border CornerRadius="9" Padding="8,1,8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                  Background="{Binding Items[0].GroupBadgeBg}" ToolTip="{Binding Items[0].GroupBadgeTip}">
                            <TextBlock Text="{Binding Items[0].GroupBadge}" FontSize="11.5" Foreground="{Binding Items[0].GroupBadgeFg}"/>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </ListView.GroupStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="删除" Width="52">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <CheckBox x:Name="Chk" IsChecked="{Binding ToDelete, Mode=TwoWay}" HorizontalAlignment="Center"/>
                          <TextBlock x:Name="Lock" Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#86868B" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Visibility="Collapsed" ToolTip="C 盘个人文件夹里的文件受保护，不会删除"/>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding CanDelete}" Value="False">
                            <Setter TargetName="Chk" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="位置" Width="520">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Dir, Mode=OneWay}" Foreground="#86868B"/><Run Text="{Binding FileName, Mode=OneWay}" Foreground="#1D1D1F"/>
                        </TextBlock>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="修改时间" Width="136">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Modified}" Foreground="#6E6E73"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="注意" Width="230">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Risk}" ToolTip="{Binding Risk}" Foreground="#C93400" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="" Width="80">
                    <GridViewColumn.CellTemplate><DataTemplate><Button Content="打开位置" Tag="{Binding Path}" Style="{StaticResource LinkButton}"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
            <StackPanel x:Name="EmptyDup" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,30" IsHitTestVisible="False">
              <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptyDupText" Text="设置好条件后，点右上角「开始查找」" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <CheckBox x:Name="DupProtect" Content="不删 C 盘个人文件夹里的文件" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTip="桌面、文档、下载、图片、视频、音乐等 C 盘个人文件夹里的副本一律保留，只删其他位置的副本"/>
          <CheckBox x:Name="DupRecycle" Content="放入回收站，可以恢复" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Button x:Name="BtnDupMove" Content="归档勾选的…" Margin="0,0,8,0" Padding="16,8" IsEnabled="False"
                  ToolTip="不删，把勾选的文件搬到你选的一个文件夹里（按原来的盘符和路径放，不会重名覆盖），想清楚了再删"/>
          <Button x:Name="BtnDupMerge" Content="合并为一份" Margin="0,0,8,0" Padding="16,8" IsEnabled="False"
                  ToolTip="勾选的副本换成指向保留那份的硬链接：每个位置的文件都还在，只占一份空间。只适用于同一块盘上的副本"/>
          <Button x:Name="BtnDupDelete" Content="删除勾选的文件" Style="{StaticResource Danger}" Padding="20,8" IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="DupSummary" Text="" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,16,0"/>
      </DockPanel>
    </Grid>

    <!-- ==================== 空间地图 ==================== -->
    <Grid x:Name="PageMap" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <CheckBox x:Name="MapFast" Content="快速扫描" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                    ToolTip="直接读取 NTFS 的文件表（MFT），比逐个文件夹查看快得多。少数安全软件对直接读盘会提示，可以关掉，改为逐个文件夹扫描。清理、搬家、软件管理统计大小时也按这个设置。"/>
          <ComboBox x:Name="MapDrive" Width="200" Margin="0,0,8,0"/>
          <Button x:Name="BtnMapStop" Content="停止" Margin="0,0,8,0" IsEnabled="False"/>
          <Button x:Name="BtnMapScan" Content="扫描" Style="{StaticResource Primary}" Padding="20,6"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="空间地图" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="看清每个文件夹和文件占了多少空间。"/>
        </StackPanel>
      </DockPanel>
      <!-- 每块盘一张卡片：用量条、温度、磨损、健康状态。颜色按档位：绿正常、橙要留意、红有问题 -->
      <Border x:Name="MapHealthBox" Grid.Row="1" Margin="0,0,0,12" Visibility="{DynamicResource MapHealthVis}">
        <StackPanel>
          <ItemsControl x:Name="MapHealth">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="DcCard" Style="{StaticResource Card}" Width="{DynamicResource DcCardW}" Margin="0,0,12,8" Padding="0" Cursor="Hand" ToolTip="{Binding Tip}" Tag="{Binding}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="5" Background="{Binding Stripe}" CornerRadius="12,0,0,12"/>
                    <StackPanel Margin="14,10,14,10">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Letter}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Model}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                      </DockPanel>
                      <Grid Margin="0,8,0,0" Height="6">
                        <Border Background="#EBEBF0" CornerRadius="3"/>
                        <Border Background="{Binding BarBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarW}"/>
                      </Grid>
                      <TextBlock Text="{Binding UsedText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                      <WrapPanel Margin="0,8,0,0">
                        <Border Background="{Binding HealthBg}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding HealthText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding HealthFg}"/></Border>
                        <Border x:Name="TempChip" Background="{Binding TempBg}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding TempText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding TempFg}"/></Border>
                        <Border x:Name="WearChip" Background="{Binding WearBg}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding WearText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding WearFg}"/></Border>
                        <TextBlock x:Name="HoursText" Text="{Binding HoursText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,4"/>
                      </WrapPanel>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Sel}" Value="True"><Setter TargetName="DcCard" Property="BorderBrush" Value="#0071E3"/><Setter TargetName="DcCard" Property="BorderThickness" Value="2"/></DataTrigger>
                  <DataTrigger Binding="{Binding HasTemp}" Value="False"><Setter TargetName="TempChip" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding HasWear}" Value="False"><Setter TargetName="WearChip" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding HasHours}" Value="False"><Setter TargetName="HoursText" Property="Visibility" Value="Collapsed"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="MapHealthNote" Style="{StaticResource Caption}" Text="正在读取各块盘的健康信息…"/>
        </StackPanel>
      </Border>
      <DockPanel Grid.Row="2" Margin="0,0,0,10">
        <Border x:Name="MapViewBox" DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="MapViewDirs" GroupName="mapview" Content="文件夹" IsChecked="True" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="MapViewTree" GroupName="mapview" Content="方块图" Style="{StaticResource Seg}" ToolTip="每个方块的大小就是它占的空间。单击选中，双击文件夹往里点"/>
            <RadioButton x:Name="MapViewTypes" GroupName="mapview" Content="按类型" Style="{StaticResource Seg}" ToolTip="这块盘上视频、图片、文档、程序、日志各占多少。双击一类，到「找文件」里看这一类最大的文件"/>
            <RadioButton x:Name="MapViewFiles" GroupName="mapview" Content="找文件" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="MapViewGrow" GroupName="mapview" Content="和上次比" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="MapViewRecent" GroupName="mapview" Content="最近改动" Style="{StaticResource Seg}" ToolTip="按文件系统的变更日志，看这几天哪些文件夹新建、改写的文件最多：多出来的空间多半在那里"/>
          </StackPanel>
        </Border>
        <Button x:Name="BtnMapExport" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="导出 CSV" Margin="0,0,10,0" VerticalAlignment="Center" IsEnabled="False"
                ToolTip="把现在看到的列表存成 CSV 文件，可以用 Excel 打开"/>
        <Button x:Name="BtnMapReport" DockPanel.Dock="Right" Style="{StaticResource Small}" Content="导出报告" Margin="0,0,8,0" VerticalAlignment="Center" IsEnabled="False"
                ToolTip="把这块盘的空间情况存成一个网页报告：方块图、最大的文件夹和文件、各类文件占多少、和上次比的变化。在浏览器里按 Ctrl+P 可以存成 PDF"/>
        <!-- 左边是「上一级」和路径；地方不够时说明文字末尾省略，「空间明细」靠右一直看得见，不会被右边的按钮挡住 -->
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="BtnMapBack" Style="{StaticResource Small}" Padding="8,3" Margin="0,0,4,0" IsEnabled="False" ToolTip="后退到刚才看的文件夹（鼠标侧键、Alt+←）">
              <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnMapFwd" Style="{StaticResource Small}" Padding="8,3" Margin="0,0,8,0" IsEnabled="False" ToolTip="前进（鼠标侧键、Alt+→）">
              <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="BtnMapUp" Style="{StaticResource Small}" IsEnabled="False" ToolTip="回到上一级文件夹（Backspace）" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="上一级" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <!-- 路径上的每一层都能点，点哪一层回到哪一层 -->
            <StackPanel x:Name="MapCrumbs" Orientation="Horizontal" Visibility="Collapsed" ClipToBounds="True"/>
            <TextBlock x:Name="MapPath" Text="还没有扫描" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
            <DockPanel>
              <Button x:Name="BtnMapAcct" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="空间明细" FontSize="12" Padding="10,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"
                      ToolTip="已用空间都花在哪：文件实际占用、文件表（MFT）、硬链接、压缩和稀疏文件，以及为什么和按文件大小相加对不上"/>
              <TextBlock x:Name="MapInfo" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="选一块盘，点「扫描」。C 盘通常一两分钟就能扫完。"/>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </DockPanel>
      <!-- 找文件的条件：只在「找文件」时显示 -->
      <WrapPanel x:Name="MapFilter" Grid.Row="3" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="大小至少" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapMinSize" Width="96" SelectedIndex="2">
            <ComboBoxItem Content="1 MB" Tag="1"/><ComboBoxItem Content="10 MB" Tag="10"/><ComboBoxItem Content="50 MB" Tag="50"/>
            <ComboBoxItem Content="100 MB" Tag="100"/><ComboBoxItem Content="500 MB" Tag="500"/><ComboBoxItem Content="1 GB" Tag="1024"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="多久没改过" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapAge" Width="120" SelectedIndex="0">
            <ComboBoxItem Content="不限" Tag="0"/><ComboBoxItem Content="30 天以上" Tag="30"/><ComboBoxItem Content="半年以上" Tag="182"/>
            <ComboBoxItem Content="1 年以上" Tag="365"/><ComboBoxItem Content="2 年以上" Tag="730"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="类型" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapType" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="全部" Tag=""/>
            <ComboBoxItem Content="视频" Tag="video"/>
            <ComboBoxItem Content="压缩包和安装包" Tag="archive"/>
            <ComboBoxItem Content="光盘映像和虚拟磁盘" Tag="image"/>
            <ComboBoxItem Content="图片" Tag="picture"/>
            <ComboBoxItem Content="音乐" Tag="music"/>
            <ComboBoxItem Content="文档" Tag="doc"/>
            <ComboBoxItem Content="程序和游戏数据" Tag="program"/>
            <ComboBoxItem Content="日志、转储和临时文件" Tag="log"/>
            <ComboBoxItem Content="代码和开发文件" Tag="code"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="所有者" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapOwner" Width="170" SelectedIndex="0" ToolTip="按文件的所有者（Windows 账户）筛选。只在列出来的这些文件里分">
            <ComboBoxItem Content="全部" Tag=""/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="排序" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapSort" Width="140" SelectedIndex="0">
            <ComboBoxItem Content="大的在前" Tag="size"/><ComboBoxItem Content="最近改过的在前" Tag="new"/><ComboBoxItem Content="最久没改的在前" Tag="old"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="名称" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <TextBox x:Name="MapName" Width="150" ToolTip="文件名里包含这些字。可以用 * 和 ?，比如 *.mp4、备份*"/>
        </StackPanel>
        <CheckBox x:Name="MapUnder" Content="只找当前文件夹里的" VerticalAlignment="Center" Margin="0,2,18,2"/>
        <CheckBox x:Name="MapChat" Content="只找聊天软件里的" VerticalAlignment="Center" Margin="0,2,0,2"
                  ToolTip="微信、QQ、企业微信、飞书、钉钉、Telegram 等聊天记录文件夹里的大文件。这些文件只能查看、打开位置；要腾地方，可以到「搬家管理」把整个聊天记录搬到其他盘。"/>
      </WrapPanel>
      <WrapPanel x:Name="MapGrowBar" Grid.Row="3" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="和哪次比" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapGrowBase" Width="150" SelectedIndex="0" ToolTip="每次扫描都会存一份快照（每块盘最多留 40 份）。选一个时间，和那时候的快照比">
            <ComboBoxItem Content="上一次扫描" Tag="0"/><ComboBoxItem Content="1 天前" Tag="1"/><ComboBoxItem Content="3 天前" Tag="3"/>
            <ComboBoxItem Content="7 天前" Tag="7"/><ComboBoxItem Content="30 天前" Tag="30"/><ComboBoxItem Content="最早的一次" Tag="9999"/>
          </ComboBox>
        </StackPanel>
      </WrapPanel>
      <WrapPanel x:Name="MapRecentBar" Grid.Row="3" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
          <TextBlock Text="最近" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MapRecentDays" Width="120" SelectedIndex="0">
            <ComboBoxItem Content="24 小时" Tag="1"/><ComboBoxItem Content="3 天" Tag="3"/><ComboBoxItem Content="7 天" Tag="7"/><ComboBoxItem Content="30 天" Tag="30"/>
          </ComboBox>
        </StackPanel>
        <Button x:Name="BtnMapRecent" Content="查看" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,2,0,2"/>
      </WrapPanel>
      <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0,6,0,6">
        <Grid x:Name="MapGrid" Grid.IsSharedSizeScope="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- 概览：这块盘用了多少，系统、个人文件、缓存各占多少（扫描后才有） -->
          <Border x:Name="MapOverview" Grid.Row="0" Margin="18,6,18,8" Visibility="Collapsed">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                  <TextBlock Text="已使用" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock x:Name="MapOvPct" Text="" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="MapOvTitle" Text="" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="MapOvUsed" Text="" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
              </DockPanel>
              <Grid x:Name="MapOvBar" Height="10" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#3B82F6" CornerRadius="5,0,0,5" Margin="0,0,1,0"/>
                <Border Grid.Column="1" Background="#E0A731" Margin="0,0,1,0"/>
                <Border Grid.Column="2" Background="#3FA37E" Margin="0,0,1,0"/>
                <Border Grid.Column="3" Background="#8E8E93" Margin="0,0,1,0"/>
                <Border Grid.Column="4" Background="#9B6FD6" CornerRadius="0,5,5,0"/>
              </Grid>
              <WrapPanel x:Name="MapOvLegend" Margin="0,8,0,0"/>
              <!-- 值得一看：可能用不上、删了能腾出不少空间的大文件夹（缓存、依赖包、构建产物、虚拟环境、临时文件），点一下跳过去看 -->
              <DockPanel x:Name="MapWorthBox" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Text="值得一看" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,12,0"
                           ToolTip="这块盘上可能用不上、删了能腾出不少空间的大文件夹：缓存、依赖包（node_modules 等）、构建产物、虚拟环境、临时文件。只是按名字认的，点一下跳过去，看清楚再决定"/>
                <WrapPanel x:Name="MapWorth"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <DockPanel x:Name="MapTreeBox" Grid.Row="1" Visibility="Collapsed">
            <!-- 颜色是这个文件夹装的是哪一类东西；带斜线的是能腾出来的（缓存、依赖包、临时文件） -->
            <WrapPanel x:Name="MapTreeLegend" DockPanel.Dock="Bottom" Margin="12,0,12,6"/>
            <Canvas x:Name="MapTree" Margin="10,4,10,6" ClipToBounds="True" Background="White"/>
          </DockPanel>
          <DockPanel Grid.Row="2">
          <!-- 表头：点「名称」「修改时间」「大小」排序，点第三下回到按大小排 -->
          <Border x:Name="MapHeadBox" DockPanel.Dock="Top" Style="{StaticResource HeadBar}" Margin="6,0,6,2" Visibility="Collapsed">
            <Grid x:Name="MapHead" Margin="12,0,14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MapCk"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MapBar"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MapPct"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Tag="name" Content="名称" Style="{StaticResource ColHead}"/>
                <TextBlock Text="·" Foreground="#C7C7CC" Margin="7,0" VerticalAlignment="Center"/>
                <Button Tag="when" Content="修改时间" Style="{StaticResource ColHead}"/>
              </StackPanel>
              <Button Grid.Column="4" Tag="size" Content="大小" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <ListView x:Name="MapList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource MapRowTpl}" ItemContainerStyle="{StaticResource SelRow}" SelectionMode="Extended"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ContextMenu>
              <ContextMenu x:Name="MapMenu" Style="{StaticResource Menu}">
                <MenuItem x:Name="MmEnter" Header="打开文件夹" Style="{StaticResource MenuRow}"/>
                <MenuItem x:Name="MmOpen" Header="在资源管理器里显示" Style="{StaticResource MenuRow}"/>
                <MenuItem x:Name="MmCopy" Header="复制路径" Style="{StaticResource MenuRow}"/>
                <Separator Style="{StaticResource MenuSep}"/>
                <MenuItem x:Name="MmCompress" Header="压缩（不删文件）" Style="{StaticResource MenuRow}"/>
                <MenuItem x:Name="MmMark" Header="加入待删清单" Style="{StaticResource MenuRow}"/>
                <MenuItem x:Name="MmDelete" Header="删除…" Style="{StaticResource MenuRow}"/>
              </ContextMenu>
            </ListView.ContextMenu>
          </ListView>
          </DockPanel>
          <ListView x:Name="MapGrow" Grid.Row="2" Background="White" BorderThickness="0" ItemContainerStyle="{StaticResource GridRow}" Visibility="Collapsed">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="文件夹" Width="480">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="上次" Width="110">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Before}" Foreground="#6E6E73"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="这次" Width="110">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Now}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="变化" Width="120">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Change}" Foreground="{Binding ChangeBrush}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel x:Name="EmptyMap" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyMapText" Text="点右上角「扫描」，看看这块盘的空间都去哪了" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="5">
      <!-- 待删清单：在不同文件夹里挑的都放在这里，一直看得见删完以后这块盘还剩多少；看过清单再一起删 -->
      <Border x:Name="MapMarkBar" Background="#FFF4E5" BorderBrush="#F3D9A8" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,12,0,0" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnMarkClear" Content="清空清单" Style="{StaticResource Small}" Margin="0,0,8,0"/>
            <Button x:Name="BtnMarkShow" Content="看看清单" Style="{StaticResource Small}" Margin="0,0,8,0"/>
            <Button x:Name="BtnMarkDelete" Content="删除清单里的…" Style="{StaticResource Danger}" Padding="14,4"/>
          </StackPanel>
          <TextBlock x:Name="MapMarkText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
      </Border>
      <DockPanel Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnMapOpen" Content="打开位置" Margin="0,0,8,0" IsEnabled="False"/>
          <Button x:Name="BtnMapCompress" Content="压缩（不删文件）" Margin="0,0,8,0" IsEnabled="False"
                  ToolTip="用 NTFS 压缩这个文件夹：文件照常打开、照常修改，只是占的空间变小。适合不常用的资料、旧项目"/>
          <Button x:Name="BtnMapMark" Content="加入待删清单" Margin="0,0,8,0" IsEnabled="False"
                  ToolTip="先放进清单，不马上删：可以接着到别的文件夹里挑，下面一直显示删完以后还剩多少空间，看过清单再一起删"/>
          <Button x:Name="BtnMapDelete" Content="删除…" Style="{StaticResource Danger}" Padding="18,6" IsEnabled="False"/>
        </StackPanel>
        <CheckBox x:Name="MapAll" DockPanel.Dock="Left" Content="全选" Visibility="{DynamicResource MapCkVis}" VerticalAlignment="Center" Margin="18,0,12,0" ToolTip="选中这一层列出的全部项目；再点一下全部取消"/>
        <TextBlock x:Name="MapSel" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#6E6E73" Margin="2,0,16,0"
                   Text="选中一行可以打开位置、压缩或删除；勾选前面的方框，或按住 Ctrl、Shift，可以选多项一起删；按住鼠标（左键或右键）上下拖可以一次选中连着的几行。系统文件夹、软件安装文件夹、C 盘个人文件夹和搬家后的数据带小锁，不能在这里删。"/>
      </DockPanel>
      </StackPanel>
    </Grid>

    <!-- ==================== 省空间（不删文件） ==================== -->
    <!-- 省空间：左边是目录（一级标题下面一项一项），点哪项右边只显示那一项，不用一路往下滚 -->
    <Grid x:Name="PageSave" Grid.Column="1" Grid.Row="0" Visibility="Collapsed" Margin="30,24,30,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button x:Name="BtnSaveRefresh" DockPanel.Dock="Right" Content="刷新" VerticalAlignment="Top" Margin="16,4,0,0"/>
        <StackPanel>
          <TextBlock Text="省空间" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="不删文件也能腾出空间：压缩，或者换个位置放。"/>
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,0,8,10" Margin="0,0,16,0" VerticalAlignment="Top">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="SaveNav">
                <TextBlock x:Name="SaveHeadSys" Text="系统文件" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SaveNavCos" GroupName="savenav" Tag="Cos" Content="系统压缩" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavPf" GroupName="savenav" Tag="Pf" Content="页面文件" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavHib" GroupName="savenav" Tag="Hib" Content="休眠文件" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavRs" GroupName="savenav" Tag="Rs" Content="保留的存储" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavCs" GroupName="savenav" Tag="Cs" Content="组件存储（WinSxS）" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavDump" GroupName="savenav" Tag="Dump" Content="蓝屏转储大小" Style="{StaticResource TreeItem}"/>
                <TextBlock x:Name="SaveHeadSafe" Text="还原点和临时文件" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SaveNavRp" GroupName="savenav" Tag="Rp" Content="系统还原点" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavTmp" GroupName="savenav" Tag="Tmp" Content="临时文件夹的位置" Style="{StaticResource TreeItem}"/>
                <TextBlock x:Name="SaveHeadFiles" Text="文件和文件夹" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SaveNavFc" GroupName="savenav" Tag="Fc" Content="压缩文件夹" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavOd" GroupName="savenav" Tag="Od" Content="OneDrive 仅在线" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SaveNavMerge" GroupName="savenav" Tag="Merge" Content="合并重复文件" Style="{StaticResource TreeItem}"/>
                <TextBlock x:Name="SaveHeadVd" Text="虚拟磁盘" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SaveNavVd" GroupName="savenav" Tag="Vd" Content="虚拟磁盘和虚拟机" Style="{StaticResource TreeItem}"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="SaveScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
            <Border x:Name="SaveCardCos" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="BtnCosOff" Content="关闭" Margin="0,0,8,0"/>
                  <Button x:Name="BtnCosOn" Content="开启" Style="{StaticResource Primary}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="系统压缩（CompactOS）" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveCosState" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="Windows 自带的功能：把系统文件压缩存放，通常能省 2 到 4 GB，不影响使用。压缩要 10 到 30 分钟，期间可以照常用电脑。固态硬盘几乎感觉不到变慢；很老的机械硬盘电脑不建议开。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardPf" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="页面文件（pagefile.sys）" Style="{StaticResource CardHead}"/>
                <TextBlock x:Name="SavePfState" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="内存不够用时，Windows 把暂时用不到的数据放进这个文件，通常有几个 GB 到十几 GB。可以把它放到其他硬盘，C 盘就不再占这块空间。要重启电脑才生效。改了以后蓝屏时可能无法保存完整的内存转储，对普通用户没有影响；如果有问题，随时点「恢复系统默认」。"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <ComboBox x:Name="SavePfDrive" Width="220" Margin="0,0,8,0"/>
                  <Button x:Name="BtnPfMove" Content="改到这块盘" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnPfAuto" Content="恢复系统默认"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SaveCardHib" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="休眠文件（hiberfil.sys）" Style="{StaticResource CardHead}"/>
                <TextBlock x:Name="SaveHibState" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="休眠和「快速启动」用的文件，大小约等于内存的四成到七成。「只留快速启动」能缩小到原来的一半左右，开机速度不变，只是不能手动休眠；「关闭休眠」整个删掉它，睡眠不受影响，只是没有休眠和快速启动。"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="BtnHibReduced" Content="只留快速启动（缩小）" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnHibOff" Content="关闭休眠" Margin="0,0,8,0"/>
                  <Button x:Name="BtnHibFull" Content="恢复完整休眠"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SaveCardRp" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="BtnRestoreOpen" DockPanel.Dock="Right" Content="打开系统保护设置" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="系统还原点（卷影副本）" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveRpState" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="装更新、装驱动之前 Windows 会自动建还原点，系统出问题时可以退回去。还原点放在 C 盘的 System Volume Information 里（空间地图里带小锁的那个文件夹），只记改动过的部分，占的空间有上限，到了上限会自动删掉最旧的。觉得占得多，可以在 Windows 的「系统保护」里点「配置」，调小「最大使用量」，或者删掉这块盘的全部还原点（删了就不能再退回去）。本工具不直接删还原点。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardFc" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="BtnFolderCompress" DockPanel.Dock="Right" Content="选择文件夹…" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="压缩文件夹（NTFS 压缩）" Style="{StaticResource CardHead}"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="文件照常打开、照常修改，只是占的空间变小。文档、代码、日志、旧项目通常能省一半；照片、视频、压缩包本身已经压缩过，几乎省不了。也可以在「空间地图」里选中文件夹直接压缩。"/>
                  <TextBlock x:Name="SaveFcState" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardOd" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="BtnOdFree" DockPanel.Dock="Right" Content="改成仅在线" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="20,0,0,0" IsEnabled="False"/>
                <StackPanel>
                  <TextBlock Text="OneDrive 文件改成「仅在线」" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveOdState" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="同步过的文件本地都留着一份副本。改成「仅在线」后文件还在云端，资源管理器里照常显示，打开时才下载，本地不再占空间。什么都不删。你设了「始终保留在此设备」的文件不动；OneDrive 要开着才会真正释放。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardRs" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="BtnRsOn" Content="重新开启" Margin="0,0,8,0" IsEnabled="False"/>
                  <Button x:Name="BtnRsOff" Content="关闭" IsEnabled="False"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Windows 保留的存储" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveRsState" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="Windows 给系统更新预留的空间，通常 7 GB 左右，空间明细里的「其他」有一部分就是它。关掉以后这块空间还给你，更新时 Windows 改为临时借用空闲空间；C 盘很满时更新可能提示空间不够，再开回来就好。有更新正在安装时改不了。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardCs" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="BtnCsAnalyze" Content="分析" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnCsClean" Content="去清理"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="组件存储（WinSxS）" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveCsState" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="点「分析」让 Windows 算一下实际多大、能清多少（要一两分钟）。"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="C:\Windows\WinSxS 看着很大，其中很多文件和 System32 是同一份（硬链接），真正能清的是更新替换下来的旧组件。Windows 自己能算出可回收多少、建不建议清理；清理在「清理 C 盘」里的「WinSxS 组件清理 (DISM)」。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardDump" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="BtnDumpSmall" Content="改成小转储" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnDumpAuto" Content="恢复自动"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="蓝屏时保存多大的转储" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="SaveDumpState" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="蓝屏时 Windows 会把内存里的内容存成 C:\Windows\MEMORY.DMP，「自动」模式下可能和内存一样大，清掉了下次蓝屏又会生成。改成「小内存转储」只存 256 KB 的摘要，够看出是哪个驱动出的问题。随时可以恢复。"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border x:Name="SaveCardTmp" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="临时文件夹的位置" Style="{StaticResource CardHead}"/>
                <TextBlock x:Name="SaveTmpState" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                           Text="各软件的临时文件默认放在 C 盘的用户目录里。可以改到其他盘，以后的临时文件就不占 C 盘了。改完要注销再登录（或重启）才对所有软件生效；个别安装程序对 C 盘以外的临时文件夹不兼容，遇到就点「恢复默认」。"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <ComboBox x:Name="SaveTmpDrive" Width="220" Margin="0,0,8,0"/>
                  <Button x:Name="BtnTmpMove" Content="改到这块盘" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnTmpAuto" Content="恢复默认"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SaveCardVd" Style="{StaticResource Card}" Padding="24,20,24,14" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="虚拟磁盘、模拟器和虚拟机" Style="{StaticResource CardHead}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,8,0,4"
                           Text="WSL、Docker、安卓模拟器、虚拟机的磁盘文件动辄几十 GB，而且在里面删了东西也不会自动变小。压缩能把空出来的部分还给 Windows；WSL 发行版和文件夹形式的可以整个搬到其他盘。"/>
                <ItemsControl x:Name="VdList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Padding="0,12,0,10">
                        <DockPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button x:Name="VdOpen" Content="打开位置" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0"/>
                            <Button x:Name="VdMove" Content="搬到其他盘" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <Button x:Name="VdCompact" Content="压缩" Tag="{Binding}" Style="{StaticResource Small}" Visibility="Collapsed"/>
                          </StackPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#6E6E73" TextWrapping="Wrap" Margin="0,4,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanCompact}" Value="True"><Setter TargetName="VdCompact" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding CanMove}" Value="True"><Setter TargetName="VdMove" Property="Visibility" Value="Visible"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="VdEmpty" Style="{StaticResource Caption}" Margin="0,8,0,0" Text="这台电脑上没找到 WSL、Docker、安卓模拟器或虚拟机的磁盘。"/>
              </StackPanel>
            </Border>

            <Border x:Name="SaveCardMerge" Style="{StaticResource Card}" Padding="24,18" Margin="0" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="BtnGoDup" DockPanel.Dock="Right" Content="去找重复文件" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="合并重复文件" Style="{StaticResource CardHead}"/>
                  <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                             Text="同一块盘上内容完全相同的文件，可以合并成一份：每个位置的文件都还在，只占一份空间。在「重复文件」页找完后，点「合并为一份」。"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ==================== 软件管理 ==================== -->
    <!-- ===== 系统健康：硬件、启动、蓝屏、活动监控、事件。读不到的明说读不到 ===== -->
    <Grid x:Name="PageHealth" Grid.Column="1" Grid.Row="0" Visibility="Collapsed" Margin="30,24,30,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- 标题和选项卡在一排：点哪一项只显示哪一项，各自有自己的滚动条 -->
      <DockPanel Grid.Row="0">
        <Button x:Name="BtnHealthRefresh" DockPanel.Dock="Right" Content="刷新" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="系统健康" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,22,4" ToolTip="硬件状态、开机用时、蓝屏原因、常见问题的修法、谁在吃资源。读不到的数据直接写明读不到，不用估算冒充"/>
          <Border x:Name="HealthTabBox" Style="{StaticResource SegBox}" VerticalAlignment="Center" Margin="0,2,0,4">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="HTabHw" GroupName="htab" Content="硬件" IsChecked="True" Style="{StaticResource Seg}"/>
              <RadioButton x:Name="HTabBoot" GroupName="htab" Content="开机用时" Style="{StaticResource Seg}"/>
              <RadioButton x:Name="HTabCrash" GroupName="htab" Content="蓝屏和崩溃" Style="{StaticResource Seg}"/>
              <RadioButton x:Name="HTabFix" GroupName="htab" Content="常见问题修复" Style="{StaticResource Seg}"/>
              <RadioButton x:Name="HTabMon" GroupName="htab" Content="活动监控" Style="{StaticResource Seg}"/>
              <RadioButton x:Name="HTabEvents" GroupName="htab" Content="Windows 事件" Style="{StaticResource Seg}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
      </DockPanel>
      <TextBlock Grid.Row="1" x:Name="HealthNote" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="正在读取…"/>
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <ScrollViewer x:Name="HealthViewHw" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <!-- 硬件：每一项一张小卡片；卡片宽度跟着窗口变，窗口拉宽（最大化）时一排放更多张，不在右边留一大块空白 -->
          <Border x:Name="HealthCardHw" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <TextBlock Text="硬件" Style="{StaticResource CardHead}"/>
              <ItemsControl x:Name="HealthCards" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="{DynamicResource HcCardW}" Margin="0,0,12,12" Padding="0" Background="#F7F7F9" CornerRadius="10" ToolTip="{Binding Tip}">
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="5" Background="{Binding Stripe}" CornerRadius="10,0,0,10"/>
                        <StackPanel Margin="14,10,14,12">
                          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          <Grid x:Name="HcBar" Margin="0,8,0,0" Height="6">
                            <Border Background="#EBEBF0" CornerRadius="3"/>
                            <Border Background="{Binding BarBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarW}"/>
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{Binding Bg}" CornerRadius="6" Padding="7,2" Margin="0,0,6,4"><TextBlock Text="{Binding Text}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Fg}"/></Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding HasBar}" Value="False"><Setter TargetName="HcBar" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="温度、磨损来自 SMART 和 ACPI；CPU 内核温度和显卡温度 Windows 不提供，要厂商工具。所有数字都是读取那一刻的。"/>
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="HealthViewBoot" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <!-- 开机 -->
          <Border x:Name="HealthCardBoot" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <TextBlock Text="开机用时" Style="{StaticResource CardHead}"/>
              <TextBlock x:Name="HealthBootText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
              <ItemsControl x:Name="HealthSlow" Margin="0,6,0,0" ItemTemplate="{StaticResource NoteRowTpl}"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" Text="数据来自 Windows 自己的「诊断-性能」日志（事件 100 和 101）。拖慢开机的程序可以到「软件管理 → 开机启动」里关掉。"/>
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
        <!-- 蓝屏和崩溃：再分三个小选项卡（诊断结论 / 蓝屏记录 / 相关事件和驱动），各自滚动，不用一路滚到底 -->
        <Grid x:Name="HealthViewCrash" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1" Margin="0,0,6,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CTabVerdict" GroupName="ctab" Content="诊断结论" IsChecked="True" Style="{StaticResource SubTab}"/>
              <RadioButton x:Name="CTabDumps" GroupName="ctab" Style="{StaticResource SubTab}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="每次蓝屏"/><Border x:Name="CTabDumpsB" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="CTabDumpsN" Style="{StaticResource TabBadgeText}"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="CTabEvents" GroupName="ctab" Style="{StaticResource SubTab}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="相关事件和驱动"/><Border x:Name="CTabEventsB" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="CTabEventsN" Style="{StaticResource TabBadgeText}"/></Border></StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="CrashViewVerdict" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <!-- 诊断结论：几次蓝屏、事件、硬盘健康放在一起看 -->
          <Border x:Name="HealthCardVerdict" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                  <Button x:Name="BtnCopyReport" Content="复制报告" Margin="0,0,8,0" ToolTip="把这一页的诊断结论、每次蓝屏的说明、相关事件和硬盘状态复制成文字，可以直接粘贴给别人"/>
                  <Button x:Name="BtnDiagPack" Content="导出诊断包…" ToolTip="把蓝屏转储、最近 30 天的系统和应用日志、系统信息、驱动列表和诊断结论打成一个 zip，方便发给懂的人看。只读不改"/>
                </StackPanel>
                <TextBlock Text="诊断结论" Style="{StaticResource CardHead}"/>
              </DockPanel>
              <ItemsControl x:Name="HealthVerdicts" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding Bg}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding Fg}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                        <StackPanel x:Name="VdPlan" Orientation="Horizontal" Margin="0,12,0,0">
                          <Button Content="{Binding PlanName}" Tag="{Binding PlanTag}" ToolTip="{Binding PlanTip}" Style="{StaticResource Primary}" Padding="16,5"/>
                          <TextBlock Text="本工具能直接做的，一次做完；做之前会列出要做什么，都能撤销" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="VdTodo" Margin="0,12,0,0">
                          <TextBlock Text="需要你自己做的" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Todo}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="VdFixes" ItemsSource="{Binding Fixes}" Margin="0,10,0,0">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" ToolTip="{Binding Tip}" IsEnabled="{Binding Enabled}" Style="{StaticResource Small}" Margin="0,0,8,6"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding HasFixes}" Value="False"><Setter TargetName="VdFixes" Property="Visibility" Value="Collapsed"/></DataTrigger>
                      <DataTrigger Binding="{Binding HasPlan}" Value="False"><Setter TargetName="VdPlan" Property="Visibility" Value="Collapsed"/></DataTrigger>
                      <DataTrigger Binding="{Binding HasTodo}" Value="False"><Setter TargetName="VdTodo" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="结论是按错误码、状态码、事件日志和硬盘健康推出来的，是排查方向，不是定论。按钮和「常见问题修复」里的是同一套：只看的直接运行，会改动的先说明要改什么。"/>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="CrashViewDumps" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <Border x:Name="HealthCardCrash" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                  <Button x:Name="BtnSfcCheck" Content="检查系统文件（只看）" Margin="0,0,8,0" ToolTip="在终端窗口里运行 sfc /verifyonly 和 DISM /ScanHealth：只检查，不改任何东西。要几分钟"/>
                  <Button x:Name="BtnSfcRepair" Content="修复系统文件…" ToolTip="在终端窗口里运行 DISM /RestoreHealth 和 sfc /scannow：会把损坏的系统文件换成正常的副本（会改系统文件，可能要联网下载）。点了会先确认"/>
                </StackPanel>
                <TextBlock Text="每次蓝屏" Style="{StaticResource CardHead}"/>
              </DockPanel>
              <TextBlock x:Name="HealthCrashText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
              <ItemsControl x:Name="HealthDumps" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F7F7F9" CornerRadius="8" Padding="12,8" Margin="0,6,0,0">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="DumpOpen" Content="打开位置" Tag="{Binding}" Style="{StaticResource Small}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding When}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Code}" Margin="10,0,0,0" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding Suspect}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{Binding SuspectBrush}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Plain}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="转储文件是本工具自己解析的（错误码、参数、状态码、出事时加载的驱动、栈上出现的驱动），不如 WinDbg 准确；「可能的驱动」只是提示，不是定论。蓝屏时间和最近装的驱动对得上的，优先怀疑那个驱动。"/>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="CrashViewEvents" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <Border x:Name="HealthCardCrashEv" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <TextBlock x:Name="HealthEventsHead" Text="最近 30 天的相关事件" Style="{StaticResource CardHead}"/>
              <ItemsControl x:Name="HealthEvents" Margin="0,6,0,0" ItemTemplate="{StaticResource NoteRowTpl}"/>
              <TextBlock x:Name="HealthDriversHead" Text="最近 30 天装的驱动" Style="{StaticResource CardHead}" Margin="0,20,0,0"/>
              <ItemsControl x:Name="HealthDrivers" Margin="0,6,0,0" ItemTemplate="{StaticResource NoteRowTpl}"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Text="意外关机、硬件错误（WHEA）、磁盘和文件系统错误按来源归并；蓝屏时间和最近装的驱动对得上的，优先怀疑那个驱动。"/>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
        </Grid>
        <!-- 常见问题修复：左边选问题，右边是这个问题的修法：一步一张卡片，从轻到重往下排，按钮在每张卡片右边 -->
        <Grid x:Name="HealthViewFix" Visibility="Collapsed" Margin="0,0,6,10">
          <Border x:Name="HealthCardFix" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="28,22,28,0">
                <TextBlock Text="常见问题修复" Style="{StaticResource CardHead}" FontSize="17"/>
                <TextBlock Style="{StaticResource Body}" Foreground="#6E6E73" Margin="0,6,0,0" Text="左边选遇到的问题，右边的修法从轻到重排，从上往下试。都是 Windows 自带的命令，在看得见的窗口里运行。"/>
                <WrapPanel Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                    <Border Background="#E5F4E9" CornerRadius="6" Padding="8,2,8,3" VerticalAlignment="Center"><TextBlock Text="只看" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D7A35"/></Border>
                    <TextBlock Text="不改任何东西" Style="{StaticResource Caption}" Foreground="#6E6E73" Margin="8,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                    <Border Background="#FFF1DB" CornerRadius="6" Padding="8,2,8,3" VerticalAlignment="Center"><TextBlock Text="会改动" FontSize="11.5" FontWeight="SemiBold" Foreground="#995700"/></Border>
                    <TextBlock Text="先说明要改什么，能撤销的写明怎么撤销" Style="{StaticResource Caption}" Foreground="#6E6E73" Margin="8,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,28,6">
                    <Border Background="#FDEBEC" CornerRadius="6" Padding="8,2,8,3" VerticalAlignment="Center"><TextBlock Text="要重启" FontSize="11.5" FontWeight="SemiBold" Foreground="#C0101C"/></Border>
                    <TextBlock Text="重启后才生效" Style="{StaticResource Caption}" Foreground="#6E6E73" Margin="8,0,0,0"/>
                  </StackPanel>
                </WrapPanel>
                <Border x:Name="FixRecBox" Background="#E3EEFF" CornerRadius="12" Padding="18,14,18,8" Margin="0,14,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="FixRecHead" Text="根据这台电脑的蓝屏诊断，建议先做" FontWeight="SemiBold" Foreground="#0A5BC4"/>
                    <ItemsControl x:Name="FixRec" Margin="0,10,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding Id}" ToolTip="{Binding Tip}" IsEnabled="{Binding Enabled}" Style="{StaticResource Small}" Margin="0,0,8,6"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19" Margin="28,12,28,16" Text="这里的修复不删除任何文件、不结束任何程序、不装驱动；Windows 更新组件是改名留底，硬盘省电和快速启动随时能改回来。系统还原、内存诊断、设备管理器是 Windows 自己的工具，里面每一步都由你确认。每次运行都记在操作日志里。"/>
              <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#E5E5EA" BorderThickness="0,1,1,1">
                  <ListBox x:Name="FixGroups" Background="Transparent" BorderThickness="0" Padding="12,12" ItemContainerStyle="{StaticResource NavItem}"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" LineHeight="20" Margin="2,2,2,2"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Border>
                <Border Grid.Column="1" BorderBrush="#E5E5EA" BorderThickness="0,1,0,1">
                  <ScrollViewer x:Name="FixDetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl x:Name="FixDetail" Content="{Binding SelectedItem, ElementName=FixGroups}" Margin="32,24,28,20" Focusable="False">
                      <ContentControl.ContentTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="{Binding Desc}" Style="{StaticResource Body}" FontSize="14" LineHeight="23" Foreground="#424245" Margin="0,8,0,22"/>
                            <ItemsControl ItemsSource="{Binding Steps}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="#F7F7F9" CornerRadius="12" Padding="18,16,18,16" Margin="0,0,0,12">
                                    <DockPanel>
                                      <Button DockPanel.Dock="Right" Content="{Binding Act}" Tag="{Binding Id}" IsEnabled="{Binding Enabled}" Style="{StaticResource Secondary}" Padding="16,6" MinWidth="84" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                      <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="#E8E8ED" VerticalAlignment="Top" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding No}" FontSize="12.5" FontWeight="SemiBold" Foreground="#3A3A3C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                      <StackPanel VerticalAlignment="Center">
                                        <WrapPanel>
                                          <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,10,0"/>
                                          <Border Background="{Binding TagBg}" CornerRadius="6" Padding="8,2,8,3" VerticalAlignment="Center" Margin="0,2,0,0"><TextBlock Text="{Binding Tag}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding TagFg}"/></Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Body}" Foreground="#6E6E73" Margin="0,6,0,0"/>
                                      </StackPanel>
                                    </DockPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </ScrollViewer>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </Grid>

        <!-- 活动监控：表格占满这一页，表格自己滚动；点列名（CPU、内存、写入速度……）按那一列从高到低排 -->
        <Grid x:Name="HealthViewMon" Visibility="Collapsed" Margin="0,0,6,10">
                    <Border x:Name="HealthCardMon" Style="{StaticResource Card}" Padding="24,18,24,14">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                  <Button x:Name="BtnMonStart" Content="开始监控" Style="{StaticResource Primary}"/>
                  <Button x:Name="BtnMonStop" Content="停止" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="谁在让电脑变慢" Style="{StaticResource CardHead}"/>
                  <TextBlock x:Name="HealthMonText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="点「开始监控」，每 3 秒采一次样：各个程序这段时间用了多少 CPU、占多少内存、往磁盘写了多少。点列名按那一列从高到低排，再点一下从低到高。不装常驻服务，关掉本工具就停。"/>
                </StackPanel>
              </DockPanel>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="「启动以来写入」是 Windows 从进程启动起累计的，重启过的进程从头算；写入量不等于磁盘净占用增长（临时文件写了又删）。哪个进程写了哪个文件，只有监控开着的时候能对上：把「空间地图 → 最近改动」里变大的文件夹和这里写入多的程序放在一起看。"/>
              <ListView x:Name="MonList" Margin="0,12,0,0" Background="White" BorderThickness="0" ItemContainerStyle="{StaticResource GridRow}">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="程序" Width="250">
                      <GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="CPU" Width="70"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CpuText}" TextAlignment="Right"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    <GridViewColumn Header="内存" Width="90"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WsText}" TextAlignment="Right"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    <GridViewColumn Header="写入速度" Width="100"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RateText}" TextAlignment="Right"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    <GridViewColumn Header="本次监控写入" Width="200">
                      <GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="{Binding Bar}" Height="8" Background="#3B82F6" CornerRadius="4" VerticalAlignment="Center"/><TextBlock Text="{Binding SinceText}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="启动以来写入" Width="110"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TotalText}" TextAlignment="Right"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </Border>
        </Grid>
        <ScrollViewer x:Name="HealthViewEvents" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
          <!-- Windows 事件 -->
          <Border x:Name="HealthCardEvents" Style="{StaticResource Card}" Padding="24,20">
            <StackPanel>
              <TextBlock Text="Windows 事件：最近 7 天的严重错误" Style="{StaticResource CardHead}"/>
              <TextBlock x:Name="HealthWinText" Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
              <ItemsControl x:Name="HealthErrors" Margin="0,6,0,0" ItemTemplate="{StaticResource NoteRowTpl}"/>
              <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="系统日志里「严重」和「错误」两级，按来源归并。很多错误是无害的（比如某个服务启动慢了一次）；同一个来源反复出现、时间又和故障对得上的才值得查。详细内容在 Windows 的「事件查看器」里。"/>
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid x:Name="PageApps" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <Button x:Name="BtnAppsUpdates" Content="检查新版本" Margin="0,0,8,0" ToolTip="用 Windows 自带的 winget 查一下装过的软件有没有新版本。只在你点的时候联网，只查不改"/>
          <Button x:Name="BtnAppsRefresh" Content="刷新"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="软件管理" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" TextWrapping="Wrap" Text="看软件占了多少，卸载、清残留，或者搬到其他盘。"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,0,10">
        <Border x:Name="AppsViewBox" DockPanel.Dock="Left" Style="{StaticResource SegBox}" VerticalAlignment="Center" Margin="0,0,14,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AppsViewApps" GroupName="appsv" Content="软件" IsChecked="True" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsViewStartup" GroupName="appsv" Content="开机启动" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsViewTasks" GroupName="appsv" Content="计划任务" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsViewMenu" GroupName="appsv" Content="右键菜单" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsViewLeft" GroupName="appsv" Content="残留文件夹" Style="{StaticResource Seg}"/>
          </StackPanel>
        </Border>
        <Border x:Name="AppsFilterBox" DockPanel.Dock="Left" Style="{StaticResource SegBox}" VerticalAlignment="Center" Margin="0,0,14,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AppsAll" GroupName="appsf" Content="全部" IsChecked="True" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsC" GroupName="appsf" Content="装在 C 盘的" Style="{StaticResource Seg}"/>
            <RadioButton x:Name="AppsStore" GroupName="appsf" Content="应用商店" Style="{StaticResource Seg}"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="AppsInfo" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#86868B" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="AppsSearch" MaxWidth="320" HorizontalAlignment="Left" MinWidth="200" ToolTip="按名字或发行商搜索"/>
        </DockPanel>
      </DockPanel>
      <StackPanel Grid.Row="2">
      <Border x:Name="AppsBatchBox" Background="#E3EEFF" BorderBrush="#B9D3F7" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,10" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="BtnBatchStop" DockPanel.Dock="Right" Content="停止" Style="{StaticResource Small}" Margin="8,0,0,0" ToolTip="不再打开后面的卸载程序；已经打开的那个照常走完"/>
          <Button x:Name="BtnBatchNext" DockPanel.Dock="Right" Content="打开下一个" Style="{StaticResource Small}" ToolTip="这个卸载程序已经走完了但没自动接上时，点这里打开下一个"/>
          <TextBlock x:Name="AppsBatchText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
      </Border>
      <Border x:Name="AppsLeftBox" Background="#FFF8EC" BorderBrush="#F3D9A8" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,10" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="BtnAppsLeftClose" DockPanel.Dock="Right" Content="不用了" Style="{StaticResource Small}" Margin="8,0,0,0"/>
          <Button x:Name="BtnAppsLeft" DockPanel.Dock="Right" Content="检查残留" Style="{StaticResource Small}"/>
          <TextBlock x:Name="AppsLeftText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
      </Border>
      </StackPanel>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0,2,0,6">
        <DockPanel Grid.IsSharedSizeScope="True">
        <!-- 表头：点列名排序（软件：名称、发行商、安装日期、大小；开机启动等：名称、状态） -->
        <Border x:Name="AppsHeadBox" DockPanel.Dock="Top" Style="{StaticResource HeadBar}" Margin="6,0,6,2">
          <Grid>
            <Grid x:Name="AppsHead" Margin="12,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="AppAct"/>
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="AppsPickAll" Grid.Column="0" VerticalAlignment="Center" ToolTip="勾上这里列出的全部；再点一下全部取消"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Tag="name" Content="名称" Style="{StaticResource ColHead}"/>
                <TextBlock Text="·" Foreground="#C7C7CC" Margin="7,0" VerticalAlignment="Center"/>
                <Button Tag="pub" Content="发行商" Style="{StaticResource ColHead}"/>
                <TextBlock Text="·" Foreground="#C7C7CC" Margin="7,0" VerticalAlignment="Center"/>
                <Button Tag="date" Content="安装日期" Style="{StaticResource ColHead}"/>
              </StackPanel>
              <Button Grid.Column="3" Tag="size" Content="大小" Style="{StaticResource ColHead}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
            </Grid>
            <Grid x:Name="StartHead" Margin="12,0,10,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="StartAct"/>
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="StartPickAll" Grid.Column="0" VerticalAlignment="Center" ToolTip="勾上这里列出的全部；再点一下全部取消"/>
              <Button Grid.Column="1" Tag="name" Content="名称" Style="{StaticResource ColHead}"/>
              <Button Grid.Column="2" Tag="status" Content="状态" Style="{StaticResource ColHead}"/>
            </Grid>
          </Grid>
        </Border>
        <!-- 勾选了几项时出现：一次卸载 / 禁用 / 启用 / 移到回收站 -->
        <Border x:Name="AppsPickBar" DockPanel.Dock="Bottom" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0" Padding="18,10,14,6" Visibility="Collapsed">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnPickClear" Content="取消选择" Style="{StaticResource Small}" Margin="0,0,8,0"/>
              <Button x:Name="BtnPickEnable" Content="启用选中的" Style="{StaticResource Small}" Margin="0,0,8,0"/>
              <Button x:Name="BtnPickDisable" Content="禁用选中的" Style="{StaticResource Small}" Margin="0,0,8,0"/>
              <Button x:Name="BtnPickRecycle" Content="移到回收站…" Style="{StaticResource Danger}" Padding="14,4"/>
              <Button x:Name="BtnPickUninstall" Content="卸载选中的…" Style="{StaticResource Danger}" Padding="14,4"/>
            </StackPanel>
            <TextBlock x:Name="AppsPickText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>
        <Grid>
          <ListView x:Name="AppsList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SelRow}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,8,10,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppAct"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" IsChecked="{Binding Picked, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False" Cursor="Hand"/>
                  <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8" Background="#EFEFF4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}" FontWeight="SemiBold" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AppUpgrade" Content="升级" Tag="{Binding}" Style="{StaticResource Small}" Foreground="#0066CC" Margin="0,0,6,0" Visibility="Collapsed"
                            ToolTip="在终端窗口里用 winget 升级这个软件，过程和提示都看得见"/>
                    <Button x:Name="AppOpen" Content="打开位置" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0"/>
                    <Button x:Name="AppMove" Content="搬到其他盘" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0" Visibility="{DynamicResource AppMoveVis}"
                            ToolTip="把整个安装文件夹搬到其他盘，C 盘原位置留一个链接，软件照常使用，不用重装"/>
                    <Button x:Name="AppUninstall" Content="卸载" Tag="{Binding}" Style="{StaticResource Small}"/>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding CanMove}" Value="False"><Setter TargetName="AppMove" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding HasUpgrade}" Value="True"><Setter TargetName="AppUpgrade" Property="Visibility" Value="Visible"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <!-- 开机启动 / 计划任务 / 右键菜单：同一个列表，按视图换内容 -->
          <ListView x:Name="StartList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SelRow}" Visibility="Collapsed"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,8,10,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="StartAct"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="Pk" Grid.Column="0" IsChecked="{Binding Picked, Mode=TwoWay}" VerticalAlignment="Center" Focusable="False" Cursor="Hand"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Detail}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartOpen" Content="打开位置" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0"/>
                    <Button x:Name="StartToggle" Content="{Binding ToggleText}" Tag="{Binding}" Style="{StaticResource Small}" MinWidth="64"/>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Open}" Value=""><Setter TargetName="StartOpen" Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <DataTrigger Binding="{Binding Ours}" Value="True"><Setter TargetName="StartToggle" Property="IsEnabled" Value="False"/><Setter TargetName="StartToggle" Property="ToolTip" Value="本工具自己的任务，请在「自动提醒」页开关"/><Setter TargetName="Pk" Property="Visibility" Value="Hidden"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyApps" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyAppsText" Text="正在读取已安装的软件…" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ==================== 搬家管理 ==================== -->
    <Grid x:Name="PageMoves" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button x:Name="BtnMovesRefresh" DockPanel.Dock="Right" Content="刷新" VerticalAlignment="Top" Margin="16,4,0,0" ToolTip="重新看看 C 盘上还有什么能搬，并刷新已经搬走的状态"/>
        <StackPanel>
          <TextBlock Text="搬家管理" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="把聊天记录、软件和大文件夹搬到其他盘，软件照常使用。"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Grid.Row="1" x:Name="MovesInfo" FontWeight="SemiBold" Margin="2,0,0,12" TextWrapping="Wrap"/>
      <!-- 左边目录：「可以搬的」下面按聊天记录、软件、其他文件夹、不适合搬的分开看；「已经搬走的」单独一项 -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,0,8,10" Margin="0,0,16,0" VerticalAlignment="Top">
          <StackPanel>
            <RadioButton x:Name="MovesTabCand" GroupName="movestab" Style="{StaticResource TreeTop}" IsChecked="True">
              <DockPanel><Border x:Name="MovesTabCandB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MovesTabCandN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="可以搬的" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
            <RadioButton x:Name="MNavChat" GroupName="movestab" Tag="chat" Style="{StaticResource TreeItem}">
              <DockPanel><Border x:Name="MNavChatB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MNavChatN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="聊天记录" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
            <RadioButton x:Name="MNavApp" GroupName="movestab" Tag="app" Style="{StaticResource TreeItem}">
              <DockPanel><Border x:Name="MNavAppB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MNavAppN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="装在 C 盘的软件" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
            <RadioButton x:Name="MNavOther" GroupName="movestab" Tag="other" Style="{StaticResource TreeItem}">
              <DockPanel><Border x:Name="MNavOtherB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MNavOtherN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="其他可搬的文件夹" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
            <RadioButton x:Name="MNavBlocked" GroupName="movestab" Tag="blocked" Style="{StaticResource TreeItem}">
              <DockPanel><Border x:Name="MNavBlockedB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MNavBlockedN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="不适合搬的软件" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
            <RadioButton x:Name="MovesTabDone" GroupName="movestab" Style="{StaticResource TreeTop}">
              <DockPanel><Border x:Name="MovesTabDoneB" DockPanel.Dock="Right" Style="{StaticResource TabBadge}" Visibility="Collapsed"><TextBlock x:Name="MovesTabDoneN" Style="{StaticResource TabBadgeText}"/></Border><TextBlock Text="已经搬走的" TextTrimming="CharacterEllipsis"/></DockPanel>
            </RadioButton>
          </StackPanel>
        </Border>
      <Grid Grid.Column="1" Grid.IsSharedSizeScope="True">
        <!-- 可以搬的：按聊天记录、软件、其他文件夹分组，勾选后一起搬；表头排序在每一组里面排 -->
        <DockPanel x:Name="CandBox">
        <Grid x:Name="CandHead" DockPanel.Dock="Top" Margin="15,0,15,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="CandAct"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="1" Tag="name" Content="名称" Style="{StaticResource ColHead}" HorizontalAlignment="Left"/>
          <Button Grid.Column="2" Tag="size" Content="大小" Style="{StaticResource ColHead}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
        </Grid>
        <ListView x:Name="CandList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainRow}" ItemTemplate="{StaticResource CandRowTpl}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AlternationCount="1000000">
          <ListView.GroupStyle>
            <GroupStyle ContainerStyle="{StaticResource CardGroup}"/>
          </ListView.GroupStyle>
        </ListView>
        </DockPanel>
        <StackPanel x:Name="EmptyCand" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyCandText" Text="正在看 C 盘上还有什么能搬…" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
        </StackPanel>
        <!-- 已经搬走的 -->
        <Border x:Name="MovesCard" Style="{StaticResource Card}" Padding="0,2,0,6" Visibility="Collapsed">
          <DockPanel>
          <Border x:Name="MovesHeadBox" DockPanel.Dock="Top" Style="{StaticResource HeadBar}" Margin="6,0,6,2">
            <Grid x:Name="MovesHead" Margin="14,0,10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MoveAct"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Tag="name" Content="名称" Style="{StaticResource ColHead}"/>
                <TextBlock Text="·" Foreground="#C7C7CC" Margin="7,0" VerticalAlignment="Center"/>
                <Button Tag="state" Content="状态" Style="{StaticResource ColHead}"/>
              </StackPanel>
              <Button Grid.Column="1" Tag="size" Content="大小" Style="{StaticResource ColHead}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
            </Grid>
          </Border>
          <Grid>
          <ListView x:Name="MovesList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SelRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="14,10,10,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="MoveAct"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                      <Run Text="{Binding Src, Mode=OneWay}"/><Run Text="  →  "/><Run Text="{Binding Dst, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MvOpen" Content="打开" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0"/>
                    <Button x:Name="MvFix" Content="修复链接" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="MvDrop" Content="删除多余副本" Tag="{Binding}" Style="{StaticResource Small}" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <Button x:Name="MvBack" Content="搬回 C 盘" Tag="{Binding}" Style="{StaticResource Small}" Visibility="Collapsed"/>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding CanFix}" Value="True"><Setter TargetName="MvFix" Property="Visibility" Value="Visible"/></DataTrigger>
                  <DataTrigger Binding="{Binding CanDrop}" Value="True"><Setter TargetName="MvDrop" Property="Visibility" Value="Visible"/></DataTrigger>
                  <DataTrigger Binding="{Binding CanBack}" Value="True"><Setter TargetName="MvBack" Property="Visibility" Value="Visible"/></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyMoves" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyMovesText" Text="还没有搬过文件夹。在「可以搬的」里勾选要搬的项目，或者在「清理 C 盘」里选「搬到其他盘」，搬好的就会出现在这里。" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
        </DockPanel>
        </Border>
      </Grid>
      </Grid>
      <DockPanel x:Name="CandStore" Grid.Row="3" Margin="2,10,0,0" Visibility="Collapsed">
        <Button x:Name="BtnCandStore" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="打开 Windows 设置" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBlock x:Name="CandStoreText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
      </DockPanel>
      <DockPanel x:Name="CandBar" Grid.Row="4" Margin="0,14,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="搬到" VerticalAlignment="Center" Foreground="#6E6E73" Margin="0,0,8,0"/>
          <ComboBox x:Name="MovesDest" Width="320" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <Button x:Name="BtnCandMove" Content="搬到其他盘" Style="{StaticResource Primary}" Padding="20,6" IsEnabled="False"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnCandAll" Style="{StaticResource LinkButton}" Content="全选" Margin="0,0,12,0" ToolTip="勾选所有聊天记录和软件。「其他文件夹」请看清说明再自己勾选"/>
          <Button x:Name="BtnCandNone" Style="{StaticResource LinkButton}" Content="全不选" Margin="0,0,16,0"/>
          <TextBlock x:Name="CandSel" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#6E6E73" Text="勾选要搬的项目。"/>
        </StackPanel>
      </DockPanel>
    </Grid>

    <!-- ==================== 自动提醒 ==================== -->
    <!-- 自动提醒：标题旁一排选项卡（空间提醒 / 定期自动清理 / 空间变化），点哪项只显示哪项 -->
    <Grid x:Name="PageAuto" Grid.Column="1" Grid.Row="0" Visibility="Collapsed" Margin="30,24,30,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Grid.Row="0">
        <TextBlock Text="自动提醒" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,22,4"/>
        <Border Style="{StaticResource SegBox}" VerticalAlignment="Center" Margin="0,2,0,4">
          <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ATabRemind" GroupName="atab" Style="{StaticResource Seg}" IsChecked="True">
                <StackPanel Orientation="Horizontal"><TextBlock Text="空间提醒"/><Border x:Name="ATabRemindB" Style="{StaticResource TabBadge}"><TextBlock x:Name="ATabRemindState" Style="{StaticResource TabBadgeText}"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ATabClean" GroupName="atab" Style="{StaticResource Seg}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="定期自动清理"/><Border x:Name="ATabCleanB" Style="{StaticResource TabBadge}"><TextBlock x:Name="ATabCleanState" Style="{StaticResource TabBadgeText}"/></Border></StackPanel>
              </RadioButton>
              <RadioButton x:Name="ATabHist" GroupName="atab" Style="{StaticResource Seg}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="空间变化"/><Border x:Name="ATabHistB" Style="{StaticResource TabBadge}"><TextBlock x:Name="ATabHistState" Style="{StaticResource TabBadgeText}"/></Border></StackPanel>
              </RadioButton>
          </StackPanel>
        </Border>
      </WrapPanel>
      <Grid Grid.Row="1">
        <TextBlock Style="{StaticResource PageSub}" TextWrapping="Wrap" Text="C 盘快满时提醒你，定期自动清理缓存。默认都关着。"/>
      </Grid>
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <ScrollViewer x:Name="AutoViewRemind" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
            <Border Style="{StaticResource Card}" Padding="24,20">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="AutoRemindOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                  <TextBlock Text="C 盘空间不足时提醒我" Style="{StaticResource CardHead}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="剩余空间低于" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox x:Name="AutoRemindGB" Width="100">
                    <ComboBoxItem Content="10 GB"/><ComboBoxItem Content="20 GB"/><ComboBoxItem Content="30 GB"/><ComboBoxItem Content="50 GB"/>
                  </ComboBox>
                  <TextBlock Text="时，在屏幕右下角弹出提醒（每天最多一次）" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="AutoJunkRow" Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="可以清理的临时文件、缓存和日志超过" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox x:Name="AutoJunkGB" Width="100">
                    <ComboBoxItem Content="不提醒"/><ComboBoxItem Content="1 GB"/><ComboBoxItem Content="2 GB"/><ComboBoxItem Content="5 GB"/><ComboBoxItem Content="10 GB"/>
                  </ComboBox>
                  <TextBlock Text="时也提醒（检查时只统计，不删任何东西）" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AutoRemindNote" Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="#6E6E73"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AutoViewClean" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
          <StackPanel Margin="0,0,6,14">
            <Border Style="{StaticResource Card}" Padding="24,20">
              <StackPanel>
                <DockPanel>
                  <CheckBox x:Name="AutoCleanOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                  <TextBlock Text="定期自动清理" Style="{StaticResource CardHead}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="什么时候清理" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox x:Name="AutoCleanWhen" Width="110">
                    <ComboBoxItem Content="每周日"/><ComboBoxItem Content="每周一"/><ComboBoxItem Content="每周二"/><ComboBoxItem Content="每周三"/><ComboBoxItem Content="每周四"/><ComboBoxItem Content="每周五"/><ComboBoxItem Content="每周六"/><ComboBoxItem Content="每天"/>
                  </ComboBox>
                  <TextBlock Text="中午 12:30（错过了就在下次开机后）" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                           Text="不用开着本工具。到时间由 Windows 任务计划在后台自动做一遍「安全清理」里的项目：临时文件、各类缓存和日志。不搬家、不清空回收站、不碰任何个人文件夹、不碰你自己加的文件夹，也不会关闭正在运行的软件（被占用的文件直接跳过）。做完在右下角告诉你释放了多少，每一项都记在「操作日志」里。"/>
                <TextBlock x:Name="AutoCleanNote" Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="#6E6E73"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AutoViewHist" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
          <StackPanel Margin="0,0,6,14">
            <Border Style="{StaticResource Card}" Padding="24,20">
              <StackPanel>
                <TextBlock Text="C 盘空间变化" Style="{StaticResource CardHead}"/>
                <TextBlock x:Name="HistInfo" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                <Border Height="220" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1">
                  <!-- 柱子平均铺满整个宽度：窗口拉宽时柱子之间的空隙跟着变大，柱子最宽 28 -->
                  <ItemsControl x:Name="HistChart" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border MaxWidth="28" Height="{Binding H}" Background="{Binding Fill}" CornerRadius="4,4,0,0" Margin="2,0" VerticalAlignment="Bottom" ToolTip="{Binding Tip}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="HistLast" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="HistFirst" Style="{StaticResource Caption}"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="柱子越高表示 C 盘已经用掉的越多（每天取最后一次记录）。每次打开本工具、每次定时检查都会记一笔。想知道是哪些文件夹变大了，到「空间地图」扫一遍，再选「和上次比」。"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ==================== 操作日志 ==================== -->
    <Grid x:Name="PageLog" Grid.Column="1" Grid.Row="0" Margin="30,24,30,14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,4,0,0">
          <Button x:Name="BtnLogOpenDir" Content="打开日志文件夹" Margin="0,0,8,0"/>
          <Button x:Name="BtnLogRefresh" Content="刷新"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="操作日志" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="每一次删除、搬家和设置改动都记在这里。"/>
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Margin="0,2,24,0">
            <TextBlock Text="日志保存时间" FontWeight="SemiBold"/>
            <ComboBox x:Name="LogKeep" Width="150" Margin="0,8,0,0">
              <ComboBoxItem Content="1 个月" Tag="1"/><ComboBoxItem Content="3 个月" Tag="3"/><ComboBoxItem Content="半年（默认）" Tag="6"/>
              <ComboBoxItem Content="1 年" Tag="12"/><ComboBoxItem Content="2 年" Tag="24"/><ComboBoxItem Content="永久保存" Tag="0"/>
            </ComboBox>
          </StackPanel>
          <TextBlock x:Name="LogKeepNote" Style="{StaticResource Body}" Foreground="#3A3A3C"/>
        </DockPanel>
      </Border>
      <WrapPanel Grid.Row="2" Margin="0,0,0,10">
        <Border Style="{StaticResource SegBox}" Margin="0,0,12,6" VerticalAlignment="Center">
          <StackPanel x:Name="LogCats" Orientation="Horizontal">
            <RadioButton GroupName="logcat" Content="全部" Tag="" IsChecked="True" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="删除" Tag="删除" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="搬运" Tag="搬运" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="合并" Tag="合并" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="压缩" Tag="压缩" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="卸载" Tag="卸载" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logcat" Content="系统设置" Tag="系统设置" Style="{StaticResource Seg}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SegBox}" Margin="0,0,12,6" VerticalAlignment="Center">
          <StackPanel x:Name="LogRange" Orientation="Horizontal">
            <RadioButton GroupName="logrange" Content="7 天" Tag="7" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logrange" Content="30 天" Tag="30" Style="{StaticResource Seg}"/>
            <RadioButton GroupName="logrange" Content="全部" Tag="0" IsChecked="True" Style="{StaticResource Seg}"/>
          </StackPanel>
        </Border>
        <TextBox x:Name="LogSearch" Width="220" Margin="0,0,12,6" ToolTip="按文件名、文件夹或操作搜索"/>
        <TextBlock x:Name="LogCount" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
      </WrapPanel>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0,0,0,6">
        <Grid>
          <ListView x:Name="LogList" Background="White" BorderThickness="0" ItemContainerStyle="{StaticResource GridRow}"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="时间" Width="150">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Foreground="#6E6E73"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="类别" Width="84">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="9" Padding="8,1,8,2" Background="{Binding CatBg}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CatText}" FontSize="11.5" Foreground="{Binding CatFg}"/>
                      </Border>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="操作" Width="210">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding What}" ToolTip="{Binding What}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="对象" Width="360">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="详情" Width="250">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="#6E6E73" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel x:Name="EmptyLog" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,30,0,0">
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="32" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyLogText" Text="还没有操作记录" Foreground="#86868B" FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ==================== 设置：外观、语言、显示哪些内容 ==================== -->
    <!-- 设置：左边目录（常用、界面、清理和扫描），点哪项右边只显示那一项 -->
    <Grid x:Name="PageSettings" Grid.Column="1" Grid.Row="0" Visibility="Collapsed" Margin="30,24,30,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,16">
      <DockPanel>
        <Button x:Name="BtnSetReset" DockPanel.Dock="Right" Content="恢复默认显示" VerticalAlignment="Top" Margin="16,4,0,0"
                ToolTip="页面、按钮、列和说明全部恢复成默认显示。外观、语言和扫描设置不变"/>
        <StackPanel>
          <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSub}" Text="外观、语言，以及界面上显示什么。"/>
        </StackPanel>
      </DockPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,0,8,10" Margin="0,0,16,0" VerticalAlignment="Top">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <TextBlock x:Name="SetHeadGeneral" Text="常用" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SetNavMode" GroupName="setnav" Tag="Mode" Content="使用模式" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SetNavLook" GroupName="setnav" Tag="Look" Content="外观和语言" Style="{StaticResource TreeItem}"/>
                <TextBlock x:Name="SetHeadUi" Text="界面" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SetNavDisplay" GroupName="setnav" Tag="Display" Content="界面上显示什么" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SetNavMap" GroupName="setnav" Tag="Map" Content="空间地图" Style="{StaticResource TreeItem}"/>
                <TextBlock x:Name="SetHeadClean" Text="清理和扫描" Style="{StaticResource TreeHead}"/>
                <RadioButton x:Name="SetNavClean" GroupName="setnav" Tag="Clean" Content="清理列表" Style="{StaticResource TreeItem}"/>
                <RadioButton x:Name="SetNavScan" GroupName="setnav" Tag="Scan" Content="扫描和查重" Style="{StaticResource TreeItem}"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="SetScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="0,0,6,14">
            <Border x:Name="SetCardMode" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="使用模式" Style="{StaticResource CardHead}"/>
                <TextBlock Style="{StaticResource SetNote}" Text="决定界面上有多少功能。换模式不会丢任何设置和记录。"/>
                <Border Style="{StaticResource SegBox}" HorizontalAlignment="Left" Margin="0,12,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SetModeBasic" GroupName="mode" Content="普通用户" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="SetModePro" GroupName="mode" Content="工程师" Style="{StaticResource Seg}"/>
                    <RadioButton x:Name="SetModeExpert" GroupName="mode" Content="开发者和 IT" Style="{StaticResource Seg}"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="SetModeNote" Style="{StaticResource SetNote}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border x:Name="SetCardLook" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="外观和语言" Style="{StaticResource CardHead}"/>
                <TextBlock Text="外观" Style="{StaticResource SetName}" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource SetNote}" Text="跟随系统时照 Windows 的「选择应用模式」。更改后本工具会重新打开。"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <RadioButton x:Name="SetThemeLight" GroupName="settheme" Style="{StaticResource ThemeCard}">
                    <StackPanel><Border x:Name="SetThemeLightPic" Style="{StaticResource ThemePic}"/><TextBlock Text="浅色" Style="{StaticResource ThemeLbl}"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="SetThemeDark" GroupName="settheme" Style="{StaticResource ThemeCard}">
                    <StackPanel><Border x:Name="SetThemeDarkPic" Style="{StaticResource ThemePic}"/><TextBlock Text="深色" Style="{StaticResource ThemeLbl}"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="SetThemeSystem" GroupName="settheme" Style="{StaticResource ThemeCard}">
                    <StackPanel><Border x:Name="SetThemeSystemPic" Style="{StaticResource ThemePic}"/><TextBlock Text="跟随系统" Style="{StaticResource ThemeLbl}"/></StackPanel>
                  </RadioButton>
                </StackPanel>
                <DockPanel Margin="0,22,0,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegBox}" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="SetLangZh" GroupName="setlang" Style="{StaticResource Seg}"/>
                      <RadioButton x:Name="SetLangEn" GroupName="setlang" Style="{StaticResource Seg}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="界面语言" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="更改后本工具会重新打开。"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SetCardDisplay" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="界面上显示什么" Style="{StaticResource CardHead}"/>
                <TextBlock Text="左侧显示的页面" Style="{StaticResource SetName}" Margin="0,14,0,0"/>
                <TextBlock Style="{StaticResource SetNote}" Text="「清理 C 盘」「空间地图」「帮助」和「设置」一直显示。关掉的页面只是不在左边列出，设置和记录都照旧。"/>
                <WrapPanel Margin="0,2,0,0">
                  <CheckBox x:Name="SetPageDup" Content="重复文件" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageSave" Content="省空间" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageApps" Content="软件管理" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageHealth" Content="系统健康" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageMoves" Content="搬家管理" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageAuto" Content="自动提醒" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetPageLog" Content="操作日志" Width="170" Margin="0,10,0,0"/>
                </WrapPanel>
                <TextBlock Text="左下角的按钮" Style="{StaticResource SetName}" Margin="0,18,0,0"/>
                <TextBlock Style="{StaticResource SetNote}" Text="外观和语言在这一页上面也能改；「使用反馈」和「运行记录」在帮助里也有。"/>
                <WrapPanel Margin="0,2,0,0">
                  <CheckBox x:Name="SetLinkTheme" Content="外观" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetLinkLang" Content="切换语言" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetLinkFeedback" Content="使用反馈" Width="170" Margin="0,10,0,0"/>
                  <CheckBox x:Name="SetLinkLog" Content="运行记录" Width="170" Margin="0,10,0,0"/>
                </WrapPanel>
                <DockPanel Margin="0,18,0,0">
                  <CheckBox x:Name="SetPageSub" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="页面标题下的说明" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="每一页标题下面那行灰色的说明。关掉后列表能多显示几行。"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SetCardMap" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="空间地图" Style="{StaticResource CardHead}"/>
                <DockPanel Margin="0,14,0,0">
                  <CheckBox x:Name="SetMapCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="项目复选框" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="每一行前面显示一个复选框，点方框才选中，按 Esc 全部取消。关掉就照 Windows 原来的做法：单击选中，按住 Ctrl 或 Shift 多选。都可以按住鼠标上下拖，一次选中连着的几行。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapBar" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="占比条" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="名字右边的蓝色横条，表示占了多少。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapPct" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="百分比" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="占这一层的百分之几。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapMeta" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="名字下面的详细信息" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="文件个数、最近修改时间、比上次扫描变了多少、链接指向哪里。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapDisk" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="实际占用和硬链接" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="快速扫描时注明压缩、稀疏和只在云端的文件实际占多少，以及硬链接（删了也不腾空间）。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapHealth" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="磁盘健康卡片" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="页面上方每块盘一张卡片：用量、健康状态，固态硬盘还有温度和磨损。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetMapFastBtn" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="右上角的「快速扫描」开关" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="只是不在空间地图上显示这个开关；快速扫描本身在「扫描和查重」里开关。"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SetCardScan" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="扫描和查重" Style="{StaticResource CardHead}"/>
                <DockPanel Margin="0,14,0,0">
                  <CheckBox x:Name="SetFast" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="快速扫描" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="直接读 NTFS 的文件表，比逐个文件夹查看快得多。少数安全软件会提示，可以关掉。"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,16,0,0">
                  <CheckBox x:Name="SetLowIo" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="查重复文件时让着其他程序" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="读文件时用 Windows 的后台模式，不拖慢正在用的程序。同时做别的事时会查得慢一些。"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border x:Name="SetCleanCard" Style="{StaticResource Card}" Padding="24,20" Margin="0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="清理列表" Style="{StaticResource CardHead}"/>
                <DockPanel x:Name="SetRecycleRow" Margin="0,14,0,0">
                  <CheckBox x:Name="SetRecycle" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="删除时先放进回收站" Style="{StaticResource SetName}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="手动清理删掉的文件先放进回收站，删错了能恢复。放不进回收站的不删。定期自动清理不受影响。"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock x:Name="SetCustomHead" Text="自己加的文件夹" Style="{StaticResource SetName}" Margin="0,14,0,0"/>
                <TextBlock x:Name="SetCustomNote" Style="{StaticResource SetNote}" Text="清理时删掉这些文件夹里的东西，文件夹本身保留。个人文件夹、系统文件夹和软件的安装文件夹加不进来。"/>
                <ItemsControl x:Name="SetCustomList" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,4,0,0">
                        <Button x:Name="SetListRemove" DockPanel.Dock="Right" Content="移除" Tag="{Binding}" Style="{StaticResource LinkButton}" FontSize="12.5" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SetCustomEmpty" Style="{StaticResource SetNote}" Text="还没有加。" Margin="0,6,0,0"/>
                <Button x:Name="BtnSetCustomAdd" Content="添加文件夹…" Style="{StaticResource Small}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <TextBlock x:Name="SetExcludeHead" Text="排除的文件夹" Style="{StaticResource SetName}" Margin="0,20,0,0"/>
                <TextBlock x:Name="SetExcludeNote" Style="{StaticResource SetNote}" Text="清理时一律不碰这些文件夹，估算大小时也不算。"/>
                <ItemsControl x:Name="SetExcludeList" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,4,0,0">
                        <Button x:Name="SetListRemove" DockPanel.Dock="Right" Content="移除" Tag="{Binding}" Style="{StaticResource LinkButton}" FontSize="12.5" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SetExcludeEmpty" Style="{StaticResource SetNote}" Text="还没有排除。" Margin="0,6,0,0"/>
